{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 mb-1 bi-title">Inventario</h1><p class="text-muted mb-0">Consulta y administra los bienes registrados.</p></header>
<div class="bi-list-controls bi-list-controls--filters mb-4"><form class="bi-list-filter-form" method="get" id="inventarioFiltros" action="{{ get_base_url() }}bienes/"><div class="catalog-global-search"><label class="visually-hidden" for="inventarioBusqueda">Buscar bienes o resguardante</label><input class="form-control" id="inventarioBusqueda" name="q" value="{{ filtros.q|default('') }}" placeholder="Buscar CI, Control Interno, serie, nombre, resguardante o unidad administrativa" autocomplete="off"></div><div class="bi-list-filter-select"><label class="visually-hidden" for="inventarioEstado">Estado del bien</label><select id="inventarioEstado" name="activo" class="form-select" aria-label="Estado del bien"><option value="">Todos los estados</option><option value="1" {{ filtros.activo|default('') == '1' ? 'selected' : '' }}>Activo</option><option value="0" {{ filtros.activo|default('') == '0' ? 'selected' : '' }}>Inactivo</option></select></div></form><button class="btn btn-outline-secondary bi-button-label" type="button" data-print-inventory-report title="Imprimir los bienes que aparecen en la tabla" aria-label="Imprimir reporte"><i class="fa-solid fa-print" aria-hidden="true"></i>Imprimir reporte</button>{% if can_create_goods|default(false) %}<a href="{{ get_base_url() }}bienes/registrar" class="btn bi-btn-primary bi-button-label" title="Agregar bien" aria-label="Agregar bien"><i class="fa-solid fa-plus" aria-hidden="true"></i>Agregar bien</a>{% endif %}</div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover mb-0 bi-inventory-table"><thead><tr><th>Clave Interna</th><th>Control Interno</th><th>Nombre Del Bien</th><th>Marca / Modelo</th><th>Serie</th><th>Resguardante</th><th>Unidad Administrativa</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="inventarioResultados">{% include 'views/bienes/_inventory-rows.twig' %}</tbody></table></div></div>
<div class="modal fade" id="codigoQrListadoModal" tabindex="-1" aria-labelledby="codigoQrListadoTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content qr-print-area"><div class="modal-header no-print"><h2 class="modal-title fs-5" id="codigoQrListadoTitulo">Código QR</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"></button></div><div class="modal-body text-center p-4"><img data-list-qr class="bi-qr-image" alt="Código QR de la clave interna del bien"><strong class="d-block mt-2 qr-value" data-list-qr-value></strong><small class="text-muted" data-list-inventory></small></div><div class="modal-footer no-print">{% if can_print_goods|default(false) %}<button class="btn btn-outline-dark bi-qr-print-button" type="button" data-print-qr title="Imprimir código QR" aria-label="Imprimir código QR"><i class="fa-solid fa-print" aria-hidden="true"></i><span class="ms-2">Imprimir</span></button>{% endif %}<button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" title="Cerrar" aria-label="Cerrar"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
