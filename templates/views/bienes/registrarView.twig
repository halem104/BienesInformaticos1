{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-form-context" aria-labelledby="bienFormTitle">
  <nav class="bi-breadcrumbs" aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ get_base_url() }}admin">Inicio</a></li><li class="breadcrumb-item"><a href="{{ get_base_url() }}bienes">Bienes</a></li><li class="breadcrumb-item active" aria-current="page">{{ bien.id_bien ? 'Editar' : 'Registrar' }}</li></ol></nav>
  <div class="bi-form-context__main">
    <div class="bi-form-context__copy"><h1 class="h3 bi-title" id="bienFormTitle">{{ bien.id_bien ? 'Editar bien' : 'Registrar bien' }}</h1><p class="text-muted">Los campos con asterisco son obligatorios.</p></div>
    <div class="bi-form-actions" aria-label="Acciones del formulario">
      <button class="btn bi-btn-primary bi-button-label" type="submit" form="bienForm"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>{{ bien.id_bien ? 'Guardar cambios' : 'Registrar bien' }}</button>
      <a class="btn btn-outline-secondary bi-button-label" href="{{ get_base_url() }}bienes" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Cancelar</a>
    </div>
  </div>
</header>

<form method="post" action="{{ get_base_url() }}bienes/guardar{{ bien.id_bien ? '/' ~ bien.id_bien : '' }}" id="bienForm">
  <input type="hidden" name="csrf" value="{{ csrf }}">
  <input type="hidden" name="id_unidad" id="unidadSeleccionadaId" value="{{ bien.id_unidad|default('') }}">
  <input type="hidden" name="componentes" id="componentesInput" value="{{ componentes_json }}">
  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>1. Identificación</strong></div><div class="card-body row g-3">
    <div class="col-md-4"><label class="form-label">Clave interna CI</label><input class="form-control" value="{{ siguiente_ci }}" readonly><div class="form-text">Se genera automáticamente y no cambia al editar.</div></div>
    <div class="col-md-4"><label class="form-label">Control Interno *</label><input class="form-control" name="numero_inventario" required value="{{ bien.numero_inventario|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">NIC / CEA</label><input class="form-control" name="nic_cea" value="{{ bien.nic_cea|default('') }}"></div>
    <div class="col-md-6"><label class="form-label">Número de serie</label><input class="form-control" name="numero_serie" value="{{ bien.numero_serie|default('') }}"></div>
    <div class="col-md-6"><label class="form-label">Nombre del bien *</label><input class="form-control" name="nombre_bien" required value="{{ bien.nombre_bien|default('') }}"></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>2. Clasificación</strong></div><div class="card-body row g-3">
    <div class="col-md-4"><label class="form-label" for="activoGenerico">Activo genérico</label><div class="input-group"><select class="form-select" name="id_activo_generico" id="activoGenerico" required><option value="">Seleccionar...</option>{% for item in activos_genericos %}<option value="{{ item.id_activo_generico }}" data-activo="{{ item.activo }}" {% if bien.id_activo_generico|default('') == item.id_activo_generico %}selected{% endif %} {% if not item.activo and bien.id_activo_generico|default('') != item.id_activo_generico %}disabled{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoGenericoModal" title="Agregar activo genérico" aria-label="Agregar activo genérico"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-4"><label class="form-label" for="grupoActivo">Grupo del Activo *</label><div class="input-group"><select class="form-select" name="id_grupo_activo" id="grupoActivo" required disabled><option value="">Seleccione primero un Activo Genérico</option>{% for item in grupos %}<option value="{{ item.id_grupo_activo }}" data-generico="{{ item.id_activo_generico }}" data-activo="{{ item.activo }}" {% if bien.id_grupo_activo|default('') == item.id_grupo_activo %}selected{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><button id="agregarGrupoBtn" class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoGrupoModal" title="Agregar grupo" aria-label="Agregar grupo" disabled><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-4"><label class="form-label" for="activoEspecifico">Activo específico *</label><div class="input-group"><select class="form-select" name="id_activo_especifico" id="activoEspecifico" required disabled><option value="">Seleccione primero un Grupo del Activo</option>{% for item in activos_especificos %}<option value="{{ item.id_activo_especifico }}" data-grupo="{{ item.id_grupo_activo }}" data-activo="{{ item.activo }}" {% if bien.id_activo_especifico|default('') == item.id_activo_especifico %}selected{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><button id="agregarEspecificoBtn" class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoEspecificoModal" title="Agregar activo específico" aria-label="Agregar activo específico" disabled><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <select id="gruposData" class="d-none">{% for item in todos_grupos %}<option data-generico="{{ item.id_activo_generico }}" data-activo="{{ item.activo }}" value="{{ item.id_grupo_activo }}">{{ item.nombre }}</option>{% endfor %}</select>
    <select id="especificosData" class="d-none">{% for item in todos_especificos %}<option data-grupo="{{ item.id_grupo_activo }}" data-activo="{{ item.activo }}" value="{{ item.id_activo_especifico }}">{{ item.nombre }}</option>{% endfor %}</select>
    <div class="col-md-6"><label class="form-label" for="marcaBien">Marca</label><div class="input-group"><select class="form-select" name="id_marca" id="marcaBien"><option value="">Seleccionar...</option>{% for item in marcas %}<option value="{{ item.id_marca }}" data-activo="{{ item.activo }}" {% if bien.id_marca|default('') == item.id_marca %}selected{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactiva){% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoMarcaModal" title="Agregar marca" aria-label="Agregar marca"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-6"><label class="form-label" for="modeloBien">Modelo</label><div class="input-group"><select class="form-select" name="id_modelo" id="modeloBien"><option value="">Seleccionar...</option>{% for item in modelos %}<option value="{{ item.id_modelo }}" data-marca="{{ item.id_marca }}" data-activo="{{ item.activo }}" {% if bien.id_modelo|default('') == item.id_modelo %}selected{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoModeloModal" title="Agregar modelo" aria-label="Agregar modelo" id="agregarModeloBtn" disabled><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>3. Información física</strong></div><div class="card-body row g-3">
    <div class="col-md-4"><label class="form-label" for="materialBien">Material</label><div class="input-group"><select class="form-select" name="id_material" id="materialBien"><option value="" {% if not bien.id_material|default(null) %}selected{% endif %}>{% if not bien.id_material|default(null) and bien.material|default('') %}Valor histórico: {{ bien.material }}{% else %}Seleccionar...{% endif %}</option>{% for item in materiales %}<option value="{{ item.id_material }}" {% if bien.id_material|default('') == item.id_material %}selected{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoMaterialModal" title="Agregar material" aria-label="Agregar material"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-4"><label class="form-label" for="colorBien">Color</label><div class="input-group"><select class="form-select" name="id_color" id="colorBien"><option value="" {% if not bien.id_color|default(null) %}selected{% endif %}>{% if not bien.id_color|default(null) and bien.color|default('') %}Valor histórico: {{ bien.color }}{% else %}Seleccionar...{% endif %}</option>{% for item in colores %}<option value="{{ item.id_color }}" {% if bien.id_color|default('') == item.id_color %}selected{% endif %}>{{ item.nombre }}{% if not item.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoColorModal" title="Agregar color" aria-label="Agregar color"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-4"><label class="form-label">Estado de uso</label><select class="form-select" name="id_estado_uso"><option value="">Seleccionar...</option>{% for item in estados %}<option value="{{ item.id_estado_uso }}" {% if bien.id_estado_uso|default('') == item.id_estado_uso %}selected{% endif %}>{{ item.nombre }}</option>{% endfor %}</select></div>
    <div class="col-12"><label class="form-label">Características</label><textarea class="form-control" rows="3" name="caracteristicas">{{ bien.caracteristicas|default('S/C', true) }}</textarea><div class="form-text">Si no hay características por capturar, conserva S/C.</div></div>
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>4. Administración y ubicación</strong></div><div class="card-body row g-3">
    <div class="col-12">
      <label class="form-label d-flex align-items-center gap-2" for="codigoUnidadManual">Código de la Unidad Administrativa <span aria-hidden="true">*</span>
        <button class="btn btn-link btn-sm p-0 text-secondary" type="button" data-bs-toggle="tooltip" data-bs-trigger="hover focus" data-bs-title="Las unidades sin código oficial permanecen visibles, pero no pueden asignarse a un bien." aria-label="Las unidades sin código oficial permanecen visibles, pero no pueden asignarse a un bien." title="Las unidades sin código oficial permanecen visibles, pero no pueden asignarse a un bien."><i class="fa-solid fa-circle-info" aria-hidden="true"></i></button>
      </label>
      <input class="form-control" type="text" name="codigo_ua" id="codigoUnidadManual" maxlength="20" autocomplete="off" required value="{{ bien.codigo_ua|default('') }}" placeholder="Escribe el código oficial" aria-autocomplete="list" aria-controls="unidadCoincidencias" aria-expanded="false" data-search-url="{{ get_base_url() }}bienes/buscar-unidades">
      <div class="list-group mt-1" id="unidadCoincidencias" role="listbox" aria-label="Coincidencias de Unidades Administrativas" hidden></div>
      <div class="form-text mt-1" id="estadoBusquedaUnidad" role="status" aria-live="polite"></div>
    </div>
    {% set ua_form = administracion_unidad|default({}) %}
    <div class="col-md-6"><label class="form-label" for="uaSecretaria">Secretaría</label><input class="form-control" id="uaSecretaria" value="{{ ua_form.secretaria|default('—', true) }}" readonly></div><div class="col-md-6"><label class="form-label" for="uaSubsecretaria">Subsecretaría</label><input class="form-control" id="uaSubsecretaria" value="{{ ua_form.subsecretaria|default('—', true) }}" readonly></div>
    <div class="col-md-6"><label class="form-label" for="uaDireccion">Dirección</label><input class="form-control" id="uaDireccion" value="{{ ua_form.direccion_secretaria|default('—', true) }}" readonly></div><div class="col-md-6"><label class="form-label" for="uaDireccionArea">Dirección de Área</label><input class="form-control" id="uaDireccionArea" value="{{ ua_form.direccion_area|default('—', true) }}" readonly></div>
    <div class="col-md-6"><label class="form-label" for="uaDelegacionAdministrativa">Delegación Administrativa</label><input class="form-control" id="uaDelegacionAdministrativa" value="{{ ua_form.delegacion_administrativa|default('—', true) }}" readonly></div><div class="col-md-6"><label class="form-label" for="uaSubdireccion">Subdirección</label><input class="form-control" id="uaSubdireccion" value="{{ ua_form.subdireccion|default('—', true) }}" readonly></div>
    <div class="col-md-6"><label class="form-label" for="uaDepartamento">Departamento</label><input class="form-control" id="uaDepartamento" value="{{ ua_form.departamento|default('—', true) }}" readonly></div><div class="col-md-6"><label class="form-label" for="uaOficina">Oficina</label><input class="form-control" id="uaOficina" value="{{ ua_form.oficina|default('—', true) }}" readonly></div>
    <div class="col-md-3"><label class="form-label" for="municipioUbicacion">Municipio</label><div class="input-group"><select class="form-select" id="municipioUbicacion"><option value="">Seleccionar...</option>{% for item in municipios %}<option value="{{ item.municipio }}" {% if bien.municipio|default('') == item.municipio %}selected{% endif %}>{{ item.municipio }}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevoMunicipioModal" title="Agregar municipio y su primera localidad" aria-label="Agregar municipio y su primera localidad"><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-3"><label class="form-label" for="localidadUbicacion">Localidad</label><div class="input-group"><select class="form-select" name="id_ubicacion" id="localidadUbicacion"><option value="">Seleccionar...</option>{% for item in ubicaciones %}<option value="{{ item.id_ubicacion }}" data-municipio="{{ item.municipio }}" {% if bien.id_ubicacion|default('') == item.id_ubicacion %}selected{% endif %}>{{ item.localidad }}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#nuevaLocalidadModal" title="Agregar localidad" aria-label="Agregar localidad" id="agregarLocalidadBtn" disabled><i class="fa-solid fa-plus" aria-hidden="true"></i></button></div></div>
    <div class="col-md-4"><label class="form-label">Piso</label><input class="form-control" name="piso" value="{{ bien.piso|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">Sección / Ala</label><input class="form-control" name="seccion_ala" value="{{ bien.seccion_ala|default('') }}"></div>
    <div class="col-md-4"><label class="form-label">Cubículo</label><input class="form-control" name="cubiculo" value="{{ bien.cubiculo|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Valor</label><input type="number" min="0" step="0.01" class="form-control" name="valor" value="{{ bien.valor|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Fecha alta</label><input type="date" class="form-control" name="fecha_alta" value="{{ bien.fecha_alta|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Adquisición</label><input type="date" class="form-control" name="fecha_adquisicion" value="{{ bien.fecha_adquisicion|default('') }}"></div>
    <div class="col-md-3"><label class="form-label">Elaboración</label><input type="date" class="form-control" name="fecha_elaboracion" value="{{ bien.fecha_elaboracion|default('') }}"></div>
    {% if not bien.id_bien %}<input type="hidden" name="activo" value="1">{% endif %}
  </div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>5. Componentes</strong></div><div class="card-body pt-3"><p class="text-muted small">Captura los datos de CPU, cargador, monitor, mouse, teclado y UPS.</p><div id="componentesConfig" data-componentes="{{ componentes_json }}"></div><div class="table-responsive"><table class="table table-bordered table-striped align-middle mb-0 bi-components-table"><thead class="table-light"><tr><th>Componente</th><th>Marca</th><th>Modelo</th><th>Serie</th><th>Inventario / Clave interna CI</th></tr></thead><tbody id="componentesLista"></tbody></table></div></div></div>

  <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>6. Asignación Y Observaciones</strong></div><div class="card-body row g-3">
    {% if not bien.id_bien %}
    <div class="col-md-8"><label class="form-label" for="bienResguardante">Resguardante inicial</label><div class="input-group"><select class="form-select" name="csp" id="bienResguardante" data-resguardante-selector><option value="">Sin Asignar</option>{% for item in resguardantes %}<option value="{{ item.csp }}" data-nombre="{{ item.nombre_completo|title }}">{{ item.csp }}</option>{% endfor %}</select><button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#resguardanteModal" data-new-resguardante data-unidad-inicial="{{ bien.id_unidad|default('') }}" title="Agregar resguardante" aria-label="Agregar resguardante"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></button></div><small id="nombreBienResguardante" class="form-text"></small></div>
    <div class="col-md-4"><label class="form-label" for="fechaAsignacionInicial">Fecha de asignación</label><input class="form-control" type="date" id="fechaAsignacionInicial" name="fecha_asignacion" value="{{ 'now'|date('Y-m-d') }}"></div>
    {% else %}
    <div class="col-md-8"><span class="form-label d-block">Resguardante actual</span><strong>{{ bien.resguardante_nombre|default('Sin asignar')|title }}</strong>{% if bien.resguardante_csp %}<small class="d-block text-muted">CSP {{ bien.resguardante_csp }}</small>{% endif %}<p class="small text-muted mt-2 mb-2">El cambio de responsable se registra en Gestión de Traspasos. Editar este bien no modifica la custodia.</p>{% if can_create_transfer|default(false) and bien.activo and bien.id_resguardante %}<a class="btn btn-sm btn-outline-primary" href="{{ get_base_url() }}traspasos/crear?bien_id={{ bien.id_bien }}" title="Crear traspaso para este bien" aria-label="Crear traspaso para este bien"><i class="fa-solid fa-arrow-right-arrow-left me-1" aria-hidden="true"></i>Ir a Traspasos</a>{% endif %}</div>
    <div class="col-md-4"><span class="form-label d-block">Fecha de asignación</span><span>{{ bien.fecha_asignacion_actual ? bien.fecha_asignacion_actual|date('d/m/Y') : (bien.fecha_asignacion ? bien.fecha_asignacion|date('d/m/Y') : 'Sin asignación activa') }}</span></div>
    {% endif %}
    <div class="col-12"><label class="form-label" for="bienObservaciones">Observaciones</label><textarea class="form-control" id="bienObservaciones" rows="3" name="observaciones">{{ bien.observaciones|default('') }}</textarea></div>
  </div></div>
</form>
{% include 'views/catalogos/_resguardante-form.twig' with {resguardante_ajax: true, unidades_resguardante: unidades_resguardante} %}
{% include 'views/catalogos/_bien-quick-add.twig' %}
{% include 'includes/admin/inventory-bottom.twig' %}
