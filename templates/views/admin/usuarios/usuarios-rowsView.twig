{% for user in users.rows %}
<tr>
  <td><strong>{{ user.username }}</strong>{% if user.id == current_user.id %}<small class="d-block text-muted">Tú</small>{% endif %}</td>
  <td>{{ user.nombre|default('—') }}</td><td>{{ user.email }}</td><td>{{ user.rol_nombre|default(user.rol) }}</td>
  <td>{% include 'includes/components/status-badge.twig' with { active: user.activo } only %}</td>
  <td class="text-end text-nowrap">
    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editarUsuarioModal" data-user-id="{{ user.id }}" data-user-first="{{ user.nombre_pila|default('')|e('html_attr') }}" data-user-paternal="{{ user.apellido_paterno|default('')|e('html_attr') }}" data-user-maternal="{{ user.apellido_materno|default('')|e('html_attr') }}" data-user-login="{{ user.username|e('html_attr') }}" data-user-email="{{ user.email|e('html_attr') }}" data-user-phone="{{ user.telefono|default('')|e('html_attr') }}" data-user-role="{{ user.rol|e('html_attr') }}" aria-label="Editar usuario {{ user.username }}" title="Editar usuario"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
    {% if user.id != current_user.id %}<form class="d-inline" method="post" action="{{ get_base_url() }}admin/cambiar_estado_usuario/{{ user.id }}" onsubmit="return confirm('¿{{ user.activo ? 'Desactivar' : 'Activar' }} esta cuenta?')"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-sm {{ user.activo ? 'btn-outline-warning' : 'btn-outline-success' }}" type="submit" aria-label="{{ user.activo ? 'Desactivar' : 'Activar' }} usuario {{ user.username }}" title="{{ user.activo ? 'Desactivar' : 'Activar' }} usuario"><i class="fa-solid {{ user.activo ? 'fa-user-slash' : 'fa-user-check' }}" aria-hidden="true"></i></button></form>{% endif %}
    {% if user.auth_token %}<a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}admin/destruir-sesion/{{ user.id }}?_t={{ csrf }}" aria-label="Cerrar sesión de {{ user.username }}" title="Cerrar sesión"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i></a>{% endif %}
  </td>
</tr>
{% else %}
<tr><td colspan="6" class="text-center text-muted py-4">No se encontraron usuarios.</td></tr>
{% endfor %}
