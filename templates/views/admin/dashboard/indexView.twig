{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <div><h1 class="h3 mb-1 bi-title">Panel de inventario</h1><p class="text-muted mb-0">Resumen operativo de bienes informáticos.</p></div>
  {% if can_create_goods|default(false) %}<a class="btn bi-btn-primary bi-button-label" href="{{ get_base_url() }}bienes/registrar" title="Agregar bien" aria-label="Agregar bien"><i class="fa-solid fa-plus" aria-hidden="true"></i>Agregar bien</a>{% endif %}
</div>
{% if can_view_goods|default(false) %}
<div class="row g-3 mb-4">
  <div class="col-12 col-md-6 col-xl-4"><article class="card bi-metric-card h-100"><div class="card-body d-flex align-items-center justify-content-between"><div><small>Total de bienes</small><h2>{{ resumen.total }}</h2></div><span class="bi-metric-icon" aria-hidden="true"><i class="fa-solid fa-boxes-stacked"></i></span></div></article></div>
  <div class="col-12 col-md-6 col-xl-4"><article class="card bi-metric-card h-100"><div class="card-body d-flex align-items-center justify-content-between"><div><small>Con resguardante</small><h2>{{ resumen.con_resguardante }}</h2></div><span class="bi-metric-icon" aria-hidden="true"><i class="fa-solid fa-user-shield"></i></span></div></article></div>
  <div class="col-12 col-md-6 col-xl-4"><article class="card bi-metric-card h-100"><div class="card-body d-flex align-items-center justify-content-between"><div><small>Pendientes de asignar</small><h2>{{ resumen.pendientes }}</h2></div><span class="bi-metric-icon" aria-hidden="true"><i class="fa-solid fa-user-clock"></i></span></div></article></div>
</div>
<section class="card shadow-sm border-0"><div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2"><h2 class="h6 mb-0 bi-title">Últimos bienes registrados</h2><a class="btn btn-sm btn-outline-secondary bi-button-label" href="{{ get_base_url() }}bienes" title="Ver inventario" aria-label="Ver inventario"><i class="fa-solid fa-eye" aria-hidden="true"></i>Ver inventario</a></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Clave interna</th><th>Control Interno</th><th>Bien</th><th>Marca / modelo</th><th>Resguardante</th><th>Unidad administrativa</th><th>Fecha de alta</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>{% for bien in recientes %}<tr><td><strong>{{ bien.clave_interna|default('—') }}</strong></td><td>{{ bien.numero_inventario|default('—') }}</td><td>{{ bien.nombre_bien|title }}</td><td>{% if bien.marca_nombre %}<strong class="d-block">{{ bien.marca_nombre|upper }}</strong><small>{{ bien.modelo_nombre|default('') }}</small>{% else %}—{% endif %}</td><td>{% if bien.resguardante_nombre %}<strong class="d-block">{{ bien.resguardante_csp|default('CSP no capturado') }}</strong><small>{{ bien.resguardante_nombre|title }}</small>{% else %}<span class="badge text-bg-light">Sin asignar</span>{% endif %}</td><td><strong class="d-block">{{ bien.codigo_ua|default('Sin código UA') }}</strong><small>{{ bien.unidad_nombre|title }}</small></td><td>{{ bien.fecha_alta ? bien.fecha_alta|date('d/m/Y') : '—' }}</td><td class="text-end"><a href="{{ get_base_url() }}bienes/detalle/{{ bien.id_bien }}" class="btn btn-sm btn-outline-secondary" title="Ver detalle" aria-label="Ver detalle de {{ bien.clave_interna|default('bien') }}"><i class="fa-solid fa-eye" aria-hidden="true"></i></a></td></tr>{% else %}<tr><td colspan="8"><div class="bi-empty-state"><strong>Aún no hay bienes registrados.</strong><span>Al registrar bienes, aparecerán aquí.</span>{% if can_create_goods|default(false) %}<a class="btn btn-sm btn-outline-primary mt-2 bi-button-label" href="{{ get_base_url() }}bienes/registrar" title="Agregar bien" aria-label="Agregar bien"><i class="fa-solid fa-plus" aria-hidden="true"></i>Agregar bien</a>{% endif %}</div></td></tr>{% endfor %}</tbody></table></div></section>
{% else %}<p class="text-muted">Tu rol no tiene permiso para consultar los bienes del panel.</p>{% endif %}
{% include 'includes/admin/inventory-bottom.twig' %}
