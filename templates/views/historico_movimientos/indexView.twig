{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h3 bi-title mb-1">Histórico de movimientos</h1><p class="text-muted mb-0">Consulta qué cambios se registraron para cada bien y cuándo ocurrieron.</p></div><span class="badge text-bg-light">{{ total_movimientos }} movimientos</span></div>
<form method="get" action="{{ get_base_url() }}historico-movimientos" class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-2 align-items-end"><div class="col-lg-5"><label class="form-label" for="movimientoBusqueda">Buscar bien, resguardante o cambio</label><input class="form-control" id="movimientoBusqueda" name="q" value="{{ filtros.q }}" placeholder="Clave interna, Control Interno, nombre, CSP..."></div><div class="col-md-4 col-lg-3"><label class="form-label" for="movimientoTipo">Tipo de movimiento</label><select class="form-select" id="movimientoTipo" name="tipo"><option value="">Todos</option>{% for tipo in tipos %}<option value="{{ tipo.tipo_movimiento }}" {% if filtros.tipo == tipo.tipo_movimiento %}selected{% endif %}>{{ tipo.etiqueta }}</option>{% endfor %}</select></div><div class="col-6 col-md-3 col-lg-2"><label class="form-label" for="movimientoDesde">Desde</label><input class="form-control" type="date" id="movimientoDesde" name="desde" value="{{ filtros.desde }}"></div><div class="col-6 col-md-3 col-lg-2"><label class="form-label" for="movimientoHasta">Hasta</label><input class="form-control" type="date" id="movimientoHasta" name="hasta" value="{{ filtros.hasta }}"></div></div><div class="d-flex gap-2 mt-3"><button class="btn bi-btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass me-1"></i>Buscar</button><a class="btn btn-outline-secondary" href="{{ get_base_url() }}historico-movimientos">Limpiar</a></div></div></form>
<section class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Fecha y hora</th><th>Movimiento</th><th>Bien</th><th>Cambio registrado</th><th>Usuario</th><th class="text-end">Acciones</th></tr></thead><tbody>
{% for item in movimientos %}<tr><td class="text-nowrap">{{ item.fecha_movimiento|date('d/m/Y H:i') }}</td><td><span class="badge text-bg-light">{{ item.tipo_etiqueta }}</span></td><td><strong class="d-block">{{ item.clave_interna|default('Sin CI') }}</strong><span>{{ item.nombre_bien|title }}</span><small class="d-block text-muted">Control Interno: {{ item.numero_inventario|default('—') }}</small></td><td>{{ item.resumen_cambio }}{% if item.motivo %}<small class="d-block text-muted">Motivo: {{ item.motivo }}</small>{% endif %}{% if item.id_traspaso %}<small class="d-block"><a href="{{ get_base_url() }}traspasos/detalle/{{ item.id_traspaso }}">Expediente {{ item.folio_traspaso }}</a></small>{% endif %}</td><td>{{ item.usuario_vista|default('No identificado') }}</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" href="{{ get_base_url() }}historico-movimientos/detalle/{{ item.id_movimiento }}">Ver detalle</a> <a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}bienes/detalle/{{ item.id_bien }}" title="Abrir ficha del bien"><i class="fa-solid fa-laptop"></i><span class="visually-hidden">Ver bien</span></a></td></tr>
{% else %}<tr><td colspan="6" class="text-center text-muted py-4">No hay movimientos que coincidan con la búsqueda.</td></tr>{% endfor %}
</tbody></table></div></section>
{% include 'includes/admin/inventory-bottom.twig' %}
