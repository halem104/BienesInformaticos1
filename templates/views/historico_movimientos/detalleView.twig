{% include 'includes/admin/inventory-top.twig' %}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a class="small text-muted" href="{{ get_base_url() }}historico-movimientos"><i class="fa-solid fa-arrow-left me-1"></i>Volver al histórico</a><h1 class="h3 bi-title mt-2 mb-1">Detalle del movimiento</h1><p class="text-muted mb-0">{{ movimiento.tipo_etiqueta }} · {{ movimiento.fecha_movimiento|date('d/m/Y H:i') }}</p></div><a class="btn btn-outline-secondary" href="{{ get_base_url() }}bienes/detalle/{{ movimiento.id_bien }}"><i class="fa-solid fa-laptop me-1"></i>Ver bien actual</a></div>
<section class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h2 class="h6 mb-0">Bien involucrado</h2></div><div class="card-body row g-3"><div class="col-md-3"><small class="text-muted d-block">Clave interna</small><strong>{{ movimiento.clave_interna|default('Sin CI') }}</strong></div><div class="col-md-3"><small class="text-muted d-block">Control Interno</small><strong>{{ movimiento.numero_inventario|default('—') }}</strong></div><div class="col-md-6"><small class="text-muted d-block">Descripción</small><strong>{{ movimiento.nombre_bien|title }}</strong></div></div></section>
{% if movimiento.id_traspaso %}<div class="alert alert-info">Este movimiento pertenece al expediente <a href="{{ get_base_url() }}traspasos/detalle/{{ movimiento.id_traspaso }}">{{ movimiento.folio_traspaso }}</a>.</div>{% endif %}
<section class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h2 class="h6 mb-0">Qué cambió</h2></div><div class="card-body"><p class="fs-6 mb-3">{{ movimiento.resumen_cambio }}</p><div class="table-responsive"><table class="table table-bordered align-middle mb-0"><thead><tr><th>Dato</th><th>Antes</th><th>Después</th></tr></thead><tbody>
<tr><th>Resguardante</th><td>{% if movimiento.csp_anterior or movimiento.nombre_resguardante_anterior_vista %}{{ movimiento.csp_anterior|default(movimiento.csp_anterior_vista) }}{% if movimiento.nombre_resguardante_anterior_vista %}<small class="d-block text-muted">{{ movimiento.nombre_resguardante_anterior_vista }}</small>{% endif %}{% else %}Sin resguardante registrado{% endif %}</td><td>{% if movimiento.csp_nuevo or movimiento.nombre_resguardante_nuevo_vista %}{{ movimiento.csp_nuevo|default(movimiento.csp_nuevo_vista) }}{% if movimiento.nombre_resguardante_nuevo_vista %}<small class="d-block text-muted">{{ movimiento.nombre_resguardante_nuevo_vista }}</small>{% endif %}{% else %}Sin resguardante registrado{% endif %}</td></tr>
<tr><th>Unidad administrativa del bien</th><td>{% if movimiento.unidad_anterior or movimiento.codigo_ua_anterior %}{{ movimiento.codigo_ua_anterior|default('') }} {{ movimiento.unidad_anterior|default('') }}{% else %}No registrada para este evento{% endif %}</td><td>{% if movimiento.unidad_nueva or movimiento.codigo_ua_nueva %}{{ movimiento.codigo_ua_nueva|default('') }} {{ movimiento.unidad_nueva|default('') }}{% else %}No registrada para este evento{% endif %}</td></tr>
<tr><th>Unidad administrativa del resguardante</th><td>{% if movimiento.unidad_resguardante_anterior or movimiento.codigo_ua_resguardante_anterior %}{{ movimiento.codigo_ua_resguardante_anterior|default('') }} {{ movimiento.unidad_resguardante_anterior|default('') }}{% else %}No registrada para este evento{% endif %}</td><td>{% if movimiento.unidad_resguardante_nueva or movimiento.codigo_ua_resguardante_nueva %}{{ movimiento.codigo_ua_resguardante_nueva|default('') }} {{ movimiento.unidad_resguardante_nueva|default('') }}{% else %}No registrada para este evento{% endif %}</td></tr>
<tr><th>Ubicación</th><td>{{ movimiento.ubicacion_anterior_vista|default('No registrada para este evento') }}</td><td>{{ movimiento.ubicacion_nueva_vista|default('No registrada para este evento') }}</td></tr>
<tr><th>Estado del bien</th><td>{{ movimiento.estado_anterior|default('No registrado para este evento') }}</td><td>{{ movimiento.estado_nuevo|default('No registrado para este evento') }}</td></tr>
</tbody></table></div></div></section>
<div class="row g-3"><div class="col-lg-6"><section class="card shadow-sm border-0 h-100"><div class="card-header bg-white"><h2 class="h6 mb-0">Motivo y observaciones</h2></div><div class="card-body"><p class="mb-2"><strong>Motivo:</strong> {{ movimiento.motivo|default('No capturado') }}</p><p class="mb-0"><strong>Observaciones:</strong> {{ movimiento.observaciones|default('Sin observaciones') }}</p></div></section></div><div class="col-lg-6"><section class="card shadow-sm border-0 h-100"><div class="card-header bg-white"><h2 class="h6 mb-0">Registro de la operación</h2></div><div class="card-body"><p><strong>Fecha y hora:</strong> {{ movimiento.fecha_movimiento|date('d/m/Y H:i:s') }}</p><p class="mb-0"><strong>Usuario:</strong> {{ movimiento.usuario_vista|default('No identificado') }}</p></div></section></div></div>
{% if not movimiento.usuario_nombre and not movimiento.unidad_anterior and not movimiento.unidad_nueva and not movimiento.ubicacion_anterior_detalle and not movimiento.ubicacion_nueva_detalle and not movimiento.csp_anterior and not movimiento.csp_nuevo %}<div class="alert alert-info mt-4 mb-0">Este movimiento es anterior al registro de instantáneas detalladas. Se muestra la información histórica que todavía está disponible, sin reconstruir datos que no fueron guardados.</div>{% endif %}
{% include 'includes/admin/inventory-bottom.twig' %}
