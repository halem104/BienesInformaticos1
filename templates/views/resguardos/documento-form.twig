<div class="card shadow-sm border-0"><div class="card-body">
  <form method="get"><label class="form-label" for="bienResguardo">Bien</label><div class="input-group"><select class="form-select" name="id" id="bienResguardo"><option value="">Seleccionar Bien...</option>{% for item in bienes %}<option value="{{ item.id_bien }}" {% if bien.id_bien|default('') == item.id_bien %}selected{% endif %}>{{ item.clave_interna|default('Sin CI') }} · {{ item.nombre_bien|title }}</option>{% endfor %}</select><button class="btn bi-btn-primary" title="Continuar" aria-label="Continuar"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i><span class="visually-hidden">Continuar</span></button></div></form>
  {% if bien %}<hr><form method="post" action="{{ get_base_url() }}reportes/documento/{{ tipo }}/{{ bien.id_bien }}"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="row"><div class="col-md-8"><h2 class="h5">{{ bien.nombre_bien|title }}</h2><p class="mb-1"><strong>CI:</strong> {{ bien.clave_interna|default('—') }}</p><p class="mb-1"><strong>Control Interno:</strong> {{ bien.numero_inventario|default('—') }}</p>
    <p class="mb-1"><strong>Resguardante:</strong>{% if bien.resguardante_nombre %}<strong class="d-block">{{ bien.resguardante_csp|default('CSP no capturado') }}</strong><small>{{ bien.resguardante_nombre|title }}</small>{% else %} Sin Asignar{% endif %}</p>
    <p class="mb-1"><strong>Unidad Del Resguardante:</strong><strong class="d-block">{{ bien.resguardante_unidad_nombre|default('Sin Unidad Registrada')|title }}</strong>{% if bien.resguardante_unidad_nombre %}<small>{{ bien.resguardante_codigo_ua|default('Sin código UA') }}</small>{% endif %}</p>
    <p class="mb-0"><strong>Unidad:</strong><strong class="d-block">{{ bien.unidad_nombre|title }}</strong><small>{{ bien.codigo_ua|default('Sin código UA') }}</small></p>
  </div>{% if can_generate_documents|default(false) %}<div class="col-md-4"><label class="form-label" for="observacionesDocumento">Observaciones Del Documento</label><textarea class="form-control" id="observacionesDocumento" name="observaciones" rows="3"></textarea></div>{% endif %}</div>
  {% if tipo == 'baja' %}<div class="row g-2 mt-2"><div class="col-md-4"><label class="form-label" for="fechaBaja">Fecha De Baja</label><input class="form-control" type="date" id="fechaBaja" name="fecha_baja" value="{{ 'now'|date('Y-m-d') }}"></div><div class="col-md-8"><label class="form-label" for="motivoBaja">Motivo De Baja</label><input class="form-control" id="motivoBaja" name="motivo"></div>{% if can_change_custody|default(false) %}<div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" name="confirmar_baja" value="1" id="confirmarBaja"><label class="form-check-label" for="confirmarBaja">Confirmo que la custodia debe quedar dada de baja.</label></div>{% endif %}</div>{% endif %}
  {% if can_generate_documents|default(false) %}<div class="mt-3"><button class="btn bi-btn-primary" title="Generar PDF" aria-label="Generar PDF"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i><span class="visually-hidden">Generar PDF</span></button></div>{% endif %}</form>{% endif %}
</div></div>
