{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 bi-title mb-1">Unidades administrativas</h1><p class="text-muted mb-0">Consulta y administra las unidades conservando su jerarquía.</p></header>
<div class="bi-list-controls mb-4"><div class="catalog-global-search"><label class="visually-hidden" for="unidadBusqueda">Buscar unidades por código o nombre</label><input class="form-control" id="unidadBusqueda" type="search" data-global-catalog-search placeholder="Buscar por código o nombre..." aria-label="Buscar unidades por código o nombre"></div>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="unidad" data-catalog-label="unidad administrativa" data-bs-toggle="modal" data-bs-target="#unidadModal" aria-label="+ Agregar Unidad Administrativa" title="Agregar Unidad Administrativa">+ Agregar Unidad Administrativa</button>{% endif %}</div>
<section class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Código UA</th><th>Tipo</th><th>Nombre</th><th>Unidad padre</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>
{% for item in unidades %}
<tr data-catalog-row>
  <td><span class="fw-semibold">{{ item.codigo_ua|default('Sin código UA') }}</span></td>
  <td>{% if item.tipo_nombre %}{{ item.tipo_nombre }}{% else %}<span class="text-muted">Pendiente de asignar</span>{% endif %}</td>
  <td>{{ item.nombre }}</td><td>{{ item.padre_nombre|default('—') }}</td>
  <td class="text-end text-nowrap">
    {% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="unidad" data-catalog-label="unidad administrativa" data-id="{{ item.id_unidad }}" data-name="{{ item.nombre }}" data-codigo-ua="{{ item.codigo_ua|default('') }}" data-tipo="{{ item.tipo|default('') }}" data-parent="{{ item.id_padre|default('') }}" data-bs-toggle="modal" data-bs-target="#unidadModal" title="Editar unidad"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</button>{% endif %}
    {% if current_user.rol|default('') == 'admin' or can_inactivate_catalogs|default(false) and item.estado_administrable is defined and item.estado_administrable %}
      {% if item.tiene_dependientes %}<span class="bi-state-switch bi-unit-state-switch" role="switch" aria-checked="{{ item.activo ? 'true' : 'false' }}" aria-disabled="true" tabindex="-1" title="No se puede cambiar el estado: esta unidad tiene unidades dependientes" aria-label="Unidad {{ item.nombre }} {{ item.activo ? 'activa' : 'inactiva' }}, bloqueada por unidades dependientes"><span class="visually-hidden">Activar/Inactivar</span></span><i class="fa-solid fa-lock text-muted ms-1" aria-hidden="true" title="Bloqueada por unidades dependientes"></i>
      {% elseif item.estado_administrable is defined and item.estado_administrable %}<a class="bi-state-switch bi-unit-state-switch" role="switch" aria-checked="{{ item.activo ? 'true' : 'false' }}" aria-label="Activar/Inactivar {{ item.nombre }} ({{ item.activo ? 'activa' : 'inactiva' }})" href="{{ get_base_url() }}catalogos/cambiar_estado/unidad/{{ item.id_unidad }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Inactivar esta unidad administrativa?' : '¿Activar esta unidad administrativa?' }}')" title="{{ item.activo ? 'Inactivar' : 'Activar' }} {{ item.nombre }}"><span class="visually-hidden">Activar/Inactivar</span></a>
      {% else %}<span class="bi-state-switch bi-unit-state-switch" role="switch" aria-checked="{{ item.activo ? 'true' : 'false' }}" aria-disabled="true" tabindex="-1" title="No se puede cambiar el estado: la tabla unidad_administrativa no cuenta con una columna de estado" aria-label="Unidad {{ item.nombre }} {{ item.activo ? 'activa' : 'inactiva' }}, cambio de estado no disponible"><span class="visually-hidden">Activar/Inactivar</span></span><i class="fa-solid fa-lock text-muted ms-1" aria-hidden="true" title="Cambio de estado no disponible"></i>{% endif %}<span class="small ms-1">Activar/Inactivar</span>
    {% endif %}
  </td>
</tr>
{% else %}<tr data-catalog-no-records><td colspan="5" class="text-center text-muted py-4">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="5" class="text-center text-muted py-4">Sin coincidencias.</td></tr>
</tbody></table></div></section>
<div class="modal fade" id="unidadModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/unidad" data-catalog-form="unidad"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Nueva unidad administrativa</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="unidadNombre">Nombre</label><input class="form-control mb-3" id="unidadNombre" name="nombre" required maxlength="250"><label class="form-label" for="unidadTipo">Tipo administrativo</label><select class="form-select mb-3" id="unidadTipo" name="tipo" data-unit-type-select>{% for tipo in tipos_unidad %}<option value="{{ tipo.clave_tipo }}" {% if tipo.clave_tipo == 'PENDIENTE' %}selected{% endif %}>{{ tipo.nombre }}</option>{% endfor %}</select><div class="form-text mb-3">Selecciona solo el tipo respaldado por la fuente institucional; si no aparece explícitamente, conserva “Pendiente de asignar”.</div><label class="form-label" for="unidadCodigo">Código UA <span class="text-muted">(opcional)</span></label><input class="form-control mb-3" id="unidadCodigo" name="codigo_ua" maxlength="20"><label class="form-label" for="unidadPadre">Unidad padre</label><select class="form-select" id="unidadPadre" name="id_padre"><option value="">Sin unidad padre</option>{% for padre in unidades_para_padre %}<option value="{{ padre.id_unidad }}">{{ padre.codigo_ua|default('Sin código UA oficial') }} · {{ padre.ruta_nombres|default(padre.nombre) }}</option>{% endfor %}</select><div class="form-text">La unidad padre conserva la relación jerárquica entre unidades.</div></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
