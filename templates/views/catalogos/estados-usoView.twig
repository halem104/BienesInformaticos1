{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 bi-title mb-1">Estados De Uso</h1></header>
<div class="bi-list-controls bi-list-controls--action-only mb-4">{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="estado" data-catalog-label="Estado De Uso" data-bs-toggle="modal" data-bs-target="#estadoModal" title="Agregar Estado De Uso" aria-label="Agregar Estado De Uso"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="ms-1">Agregar Estado De Uso</span></button>{% endif %}</div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Estado de uso</th><th>Estado</th><th>Acciones</th></tr></thead><tbody data-catalog-table>{% for estado in estados %}<tr data-catalog-row><td>{{ estado.nombre|title }}</td><td>{% include 'includes/components/status-badge.twig' with { active: estado.activo } only %}</td><td>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="estado" data-catalog-label="Estado De Uso" data-id="{{ estado.id_estado_uso }}" data-name="{{ estado.nombre }}" data-bs-toggle="modal" data-bs-target="#estadoModal" title="Editar" aria-label="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %} {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ estado.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/estado/{{ estado.id_estado_uso }}?_t={{ csrf }}" onclick="return confirm('{{ estado.activo ? '¿Desactivar este estado de uso?' : '¿Activar este estado de uso?' }}')" title="{{ estado.activo ? 'Desactivar' : 'Activar' }}" aria-label="{{ estado.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ estado.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}</td></tr>{% else %}<tr data-catalog-no-records><td colspan="3" class="text-center text-muted">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="3" class="text-center text-muted">Sin coincidencias.</td></tr></tbody></table></div></div>
<div class="modal fade" id="estadoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/estado" data-catalog-form="estado"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Estado De Uso</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Nombre Del Estado</label><input class="form-control" name="nombre" required maxlength="50"></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Cancelar</button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
