{% include 'includes/admin/inventory-top.twig' %}
<nav class="catalog-hierarchy-breadcrumb" aria-label="Ruta de clasificación"><ol class="breadcrumb mb-3" data-catalog-breadcrumb></ol></nav>
<header class="catalog-hierarchy-header mb-3">
  <h1 class="h3 bi-title mb-1">Clasificación de activos</h1>
  <p class="catalog-hierarchy-description text-muted mb-3">Explora los activos por nivel: genérico, grupo y activo específico.</p>
</header>
<div class="catalog-hierarchy-tools bi-list-controls mb-4">
    <div class="catalog-global-search"><label class="visually-hidden" for="catalogoBusqueda">Buscar en toda la clasificación</label><input class="form-control" type="search" id="catalogoBusqueda" data-global-catalog-search placeholder="Buscar en toda la clasificación…" autocomplete="off"></div>
    {% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="generico" data-catalog-label="Activo genérico" title="Agregar Activo Genérico" aria-label="Agregar Activo Genérico" data-bs-toggle="modal" data-bs-target="#catalogoGenericoModal"><i class="fa-solid fa-plus" aria-hidden="true"></i>Agregar Activo Genérico</button>{% endif %}
</div>
<div class="catalog-hierarchy" data-catalog-hierarchy>
  <section class="catalog-level-section" aria-labelledby="catalogoGenericosHeading">
    <div class="catalog-level-heading"><div><p class="catalog-level-kicker mb-1">Nivel 1</p><h2 class="h5 mb-0" id="catalogoGenericosHeading">Activos genéricos</h2></div><span class="text-muted small">Selecciona una tarjeta para ver sus grupos</span></div>
    <div class="catalog-card-grid" data-catalog-list data-catalog-level="generico">
      {% for generico in clasificacion_tree %}
      <article class="catalog-level-card" data-catalog-row>
        <button type="button" class="catalog-card-select" data-catalog-select-generico="{{ generico.id_activo_generico }}" aria-pressed="false" aria-label="Seleccionar {{ generico.nombre }}">
          <span class="catalog-card-icon" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
          <span class="catalog-card-copy"><strong>{{ generico.nombre|title }}</strong>{% if generico.descripcion %}<small>{{ generico.descripcion|title }}</small>{% endif %}</span>
          <span class="catalog-card-meta"><span>{{ generico.grupos|length }} {{ generico.grupos|length == 1 ? 'grupo relacionado' : 'grupos relacionados' }} <span aria-hidden="true">›</span></span>{% include 'includes/components/status-badge.twig' with { active: generico.activo } only %}<span class="catalog-card-selected">Seleccionado</span></span>
        </button>
        {% if can_manage_catalogs|default(false) or can_inactivate_catalogs|default(false) %}<div class="catalog-card-actions">
          {% if can_manage_catalogs|default(false) %}{% if generico.activo %}<button type="button" class="btn btn-sm btn-outline-primary bi-button-label" data-catalog-add="grupo" data-catalog-label="Grupo de activo" data-parent="{{ generico.id_activo_generico }}" data-bs-toggle="modal" data-bs-target="#catalogoGrupoModal" aria-label="Agregar grupo a {{ generico.nombre }}" title="Agregar grupo"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i><span class="visually-hidden">Agregar grupo</span></button>{% endif %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="generico" data-catalog-label="Activo genérico" data-id="{{ generico.id_activo_generico }}" data-name="{{ generico.nombre }}" data-description="{{ generico.descripcion|default('') }}" data-bs-toggle="modal" data-bs-target="#catalogoGenericoModal" aria-label="Editar {{ generico.nombre }}" title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %}
          {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ generico.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/generico/{{ generico.id_activo_generico }}?_t={{ csrf }}" onclick="return confirm('{{ generico.activo ? '¿Desactivar este activo genérico?' : '¿Activar este activo genérico?' }}')" aria-label="{{ generico.activo ? 'Desactivar' : 'Activar' }} {{ generico.nombre }}" title="{{ generico.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ generico.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}
        </div>{% endif %}
      </article>
      {% else %}<p class="catalog-level-message d-none" data-catalog-no-records>No hay activos genéricos registrados.</p>{% endfor %}
      <p class="catalog-level-message d-none" data-search-empty>No hay activos genéricos que coincidan con la búsqueda.</p>
    </div>
  </section>

  <section class="catalog-level-section" data-catalog-child-pane="grupos" aria-labelledby="catalogoGruposHeading" hidden>
    <div class="catalog-level-heading"><div><p class="catalog-level-kicker mb-1">Nivel 2</p><h2 class="h5 mb-0" id="catalogoGruposHeading">Grupos de activos</h2><small class="text-muted" data-catalog-parent-label></small></div></div>
    <p class="catalog-level-message" data-catalog-selection-prompt hidden>Selecciona un activo genérico para consultar sus grupos.</p>
    <div class="catalog-card-grid" data-catalog-list data-catalog-level="grupo">
      {% for generico in clasificacion_tree %}{% for grupo in generico.grupos %}
      <article class="catalog-level-card" data-catalog-row data-parent-generico="{{ generico.id_activo_generico }}" data-parent-name="{{ generico.nombre }}">
        <button type="button" class="catalog-card-select" data-catalog-select-grupo="{{ grupo.id_grupo_activo }}" data-parent="{{ generico.id_activo_generico }}" aria-pressed="false" aria-label="Seleccionar {{ grupo.nombre }}">
          <span class="catalog-card-icon" aria-hidden="true"><i class="fa-solid fa-folder"></i></span>
          <span class="catalog-card-copy"><strong>{{ grupo.nombre|title }}</strong><small class="catalog-card-parent">Activo genérico: {{ generico.nombre|title }}</small>{% if grupo.descripcion %}<small>{{ grupo.descripcion|title }}</small>{% endif %}</span>
          <span class="catalog-card-meta"><span>{{ grupo.activos_especificos|length }} {{ grupo.activos_especificos|length == 1 ? 'activo específico' : 'activos específicos' }} <span aria-hidden="true">›</span></span>{% include 'includes/components/status-badge.twig' with { active: grupo.activo } only %}<span class="catalog-card-selected">Seleccionado</span></span>
        </button>
        {% if can_manage_catalogs|default(false) or can_inactivate_catalogs|default(false) %}<div class="catalog-card-actions">
          {% if can_manage_catalogs|default(false) %}{% if grupo.activo %}<button type="button" class="btn btn-sm btn-outline-primary bi-button-label" data-catalog-add="especifico" data-catalog-label="Activo específico" data-parent="{{ grupo.id_grupo_activo }}" data-bs-toggle="modal" data-bs-target="#catalogoEspecificoModal" aria-label="Agregar activo específico a {{ grupo.nombre }}" title="Agregar activo específico"><i class="fa-solid fa-plus" aria-hidden="true"></i><span class="visually-hidden">Agregar activo específico</span></button>{% endif %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="grupo" data-catalog-label="Grupo de activo" data-id="{{ grupo.id_grupo_activo }}" data-name="{{ grupo.nombre }}" data-description="{{ grupo.descripcion|default('') }}" data-parent="{{ grupo.id_activo_generico }}" data-bs-toggle="modal" data-bs-target="#catalogoGrupoModal" aria-label="Editar {{ grupo.nombre }}" title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %}
          {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ grupo.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/grupo/{{ grupo.id_grupo_activo }}?_t={{ csrf }}" onclick="return confirm('{{ grupo.activo ? '¿Desactivar este grupo?' : '¿Activar este grupo?' }}')" aria-label="{{ grupo.activo ? 'Desactivar' : 'Activar' }} {{ grupo.nombre }}" title="{{ grupo.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ grupo.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}
        </div>{% endif %}
      </article>
      {% endfor %}{% endfor %}
      <p class="catalog-level-message d-none" data-catalog-no-records>No hay grupos para este activo genérico.</p><p class="catalog-level-message d-none" data-catalog-relation-empty>Este activo genérico aún no tiene grupos.</p><p class="catalog-level-message d-none" data-search-empty>No hay grupos que coincidan con la búsqueda.</p>
    </div>
  </section>

  <section class="catalog-level-section" data-catalog-child-pane="especificos" aria-labelledby="catalogoEspecificosHeading" hidden>
    <div class="catalog-level-heading"><div><p class="catalog-level-kicker mb-1">Nivel 3</p><h2 class="h5 mb-0" id="catalogoEspecificosHeading">Activos específicos</h2><small class="text-muted" data-catalog-parent-label></small></div></div>
    <p class="catalog-level-message" data-catalog-selection-prompt hidden>Selecciona un grupo para consultar sus activos específicos.</p>
    <div class="catalog-card-grid catalog-card-grid--specific" data-catalog-list data-catalog-level="especifico">
      {% for generico in clasificacion_tree %}{% for grupo in generico.grupos %}{% for especifico in grupo.activos_especificos %}
      <article class="catalog-level-card catalog-level-card--specific" data-catalog-row data-parent-grupo="{{ grupo.id_grupo_activo }}">
        <div class="catalog-specific-card-content"><span class="catalog-card-icon" aria-hidden="true"><i class="fa-solid fa-cube"></i></span><span class="catalog-card-copy"><strong>{{ especifico.nombre|title }}</strong><small class="catalog-card-parent">{{ grupo.nombre|title }} · {{ generico.nombre|title }}</small>{% if especifico.descripcion %}<small>{{ especifico.descripcion|title }}</small>{% endif %}</span>{% include 'includes/components/status-badge.twig' with { active: especifico.activo } only %}</div>
        {% if can_manage_catalogs|default(false) or can_inactivate_catalogs|default(false) %}<div class="catalog-card-actions">
          {% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="especifico" data-catalog-label="Activo específico" data-id="{{ especifico.id_activo_especifico }}" data-name="{{ especifico.nombre }}" data-description="{{ especifico.descripcion|default('') }}" data-parent="{{ especifico.id_grupo_activo }}" data-bs-toggle="modal" data-bs-target="#catalogoEspecificoModal" aria-label="Editar {{ especifico.nombre }}" title="Editar"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %}
          {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm btn-outline-{{ especifico.activo ? 'danger' : 'success' }}" href="{{ get_base_url() }}catalogos/cambiar_estado/especifico/{{ especifico.id_activo_especifico }}?_t={{ csrf }}" onclick="return confirm('{{ especifico.activo ? '¿Desactivar este activo específico?' : '¿Activar este activo específico?' }}')" aria-label="{{ especifico.activo ? 'Desactivar' : 'Activar' }} {{ especifico.nombre }}" title="{{ especifico.activo ? 'Desactivar' : 'Activar' }}"><i class="fa-solid {{ especifico.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}
        </div>{% endif %}
      </article>
      {% endfor %}{% endfor %}{% endfor %}
      <p class="catalog-level-message d-none" data-catalog-no-records>No hay activos específicos para este grupo.</p><p class="catalog-level-message d-none" data-catalog-relation-empty>Este grupo aún no tiene activos específicos.</p><p class="catalog-level-message d-none" data-search-empty>No hay activos específicos que coincidan con la búsqueda.</p>
    </div>
  </section>
</div>
<div class="modal fade" id="catalogoGenericoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/generico" data-catalog-form="generico"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Activo Genérico</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Cancelar</button></div></form></div></div></div>
<div class="modal fade" id="catalogoGrupoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/grupo" data-catalog-form="grupo"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Grupo De Activo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Activo Genérico</label><select class="form-select mb-3" name="id_activo_generico" required><option value="">Seleccionar...</option>{% for padre in genericos_para_modal %}<option value="{{ padre.id_activo_generico }}" data-active="{{ padre.activo }}">{{ padre.nombre|title }}{% if not padre.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Cancelar</button></div></form></div></div></div>
<div class="modal fade" id="catalogoEspecificoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/especifico" data-catalog-form="especifico"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar Activo Específico</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Grupo De Activo</label><select class="form-select mb-3" name="id_grupo_activo" required><option value="">Seleccionar...</option>{% for padre in grupos_para_modal %}<option value="{{ padre.id_grupo_activo }}" data-active="{{ padre.activo }}">{{ padre.nombre|title }}{% if not padre.activo %} (Inactivo){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre</label><input class="form-control mb-3" name="nombre" required maxlength="150"><label class="form-label">Descripción</label><textarea class="form-control" name="descripcion" maxlength="250" rows="3"></textarea></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save" title="Guardar" aria-label="Guardar"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" title="Cancelar" aria-label="Cancelar"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Cancelar</button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
