{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 bi-title mb-1">Ubicaciones</h1><p class="text-muted mb-0">Administra municipios y localidades disponibles para los bienes.</p></header>
<div class="bi-list-controls mb-4"><div class="catalog-global-search"><label class="visually-hidden" for="buscarUbicacion">Buscar ubicaciones</label><input class="form-control" id="buscarUbicacion" type="search" data-global-catalog-search placeholder="Buscar municipio o localidad..." aria-label="Buscar ubicaciones"></div>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="ubicacion" data-catalog-label="ubicación" data-bs-toggle="modal" data-bs-target="#ubicacionModal" aria-label="+ Agregar Ubicación" title="Agregar Ubicación">+ Agregar Ubicación</button>{% endif %}</div>
<section class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Municipio</th><th>Localidad</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>
{% for item in ubicaciones %}<tr data-catalog-row><td class="fw-semibold">{{ item.municipio }}</td><td>{{ item.localidad }}</td><td>{% include 'includes/components/status-badge.twig' with { active: item.activo, active_label: 'Activa', inactive_label: 'Inactiva' } only %}</td><td class="text-end text-nowrap">{% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="ubicacion" data-catalog-label="ubicación" data-id="{{ item.id_ubicacion }}" data-municipio="{{ item.municipio }}" data-localidad="{{ item.localidad }}" data-bs-toggle="modal" data-bs-target="#ubicacionModal" title="Editar ubicación"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</button>{% endif %} {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm bi-state-action" href="{{ get_base_url() }}catalogos/cambiar_estado/ubicacion/{{ item.id_ubicacion }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar esta ubicación?' : '¿Activar esta ubicación?' }}')"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }} me-1"></i>{{ item.activo ? 'Desactivar' : 'Activar' }}</a>{% endif %}</td></tr>
{% else %}<tr data-catalog-no-records><td colspan="4" class="text-center text-muted py-4">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="4" class="text-center text-muted py-4">Sin coincidencias.</td></tr>
</tbody></table></div></section>
<div class="modal fade" id="ubicacionModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/ubicacion" data-catalog-form="ubicacion"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar ubicación</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="ubicacionMunicipio">Municipio</label><input class="form-control mb-3" id="ubicacionMunicipio" name="municipio" required maxlength="100"><label class="form-label" for="ubicacionLocalidad">Localidad</label><input class="form-control" id="ubicacionLocalidad" name="localidad" required maxlength="100"></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
