{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 bi-title mb-1">{{ titulo }}</h1><p class="text-muted mb-0">Administra los valores disponibles para capturar bienes.</p></header>
<div class="bi-list-controls mb-4"><div class="catalog-global-search"><label class="visually-hidden" for="catalogoNombreBusqueda">Buscar {{ titulo|lower }}</label><input class="form-control" id="catalogoNombreBusqueda" type="search" data-global-catalog-search aria-label="Buscar {{ titulo|lower }}" placeholder="Buscar {{ titulo|lower }}..."></div>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="{{ tipo }}" data-catalog-label="{{ titulo|lower }}" data-bs-toggle="modal" data-bs-target="#catalogoModal" title="Agregar {{ titulo|lower }}" aria-label="Agregar {{ titulo|lower }}">+ Agregar</button>{% endif %}</div>
<section class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ titulo }}</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>{% for item in registros %}<tr data-catalog-row><td class="fw-semibold">{{ item.nombre }}</td><td>{% include 'includes/components/status-badge.twig' with { active: item.activo } only %}</td><td class="text-end text-nowrap">{% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="{{ tipo }}" data-catalog-label="{{ titulo|lower }}" data-id="{{ item[id_field] }}" data-name="{{ item.nombre }}" data-bs-toggle="modal" data-bs-target="#catalogoModal" title="Editar {{ titulo|lower }}" aria-label="Editar {{ item.nombre }}"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></button>{% endif %} {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm bi-state-action" href="{{ get_base_url() }}catalogos/cambiar_estado/{{ tipo }}/{{ item[id_field] }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar este registro?' : '¿Activar este registro?' }}')" title="{{ item.activo ? 'Desactivar' : 'Activar' }}" aria-label="{{ item.activo ? 'Desactivar' : 'Activar' }} {{ item.nombre }}"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }}" aria-hidden="true"></i></a>{% endif %}</td></tr>{% else %}<tr data-catalog-no-records><td colspan="3" class="text-center text-muted py-4">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="3" class="text-center text-muted py-4">Sin coincidencias.</td></tr></tbody></table></div></section>
<div class="modal fade" id="catalogoModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/{{ tipo }}" data-catalog-form="{{ tipo }}"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar {{ titulo|lower }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label" for="catalogoNombre">Nombre</label><input id="catalogoNombre" class="form-control" name="nombre" required maxlength="{{ tipo == 'color' ? 100 : 150 }}" autocomplete="off"></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
