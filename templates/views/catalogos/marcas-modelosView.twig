{% include 'includes/admin/inventory-top.twig' %}
<header class="bi-list-heading"><h1 class="h3 bi-title mb-1">Marcas y modelos</h1><p class="text-muted mb-0">Cada modelo conserva y muestra claramente la marca a la que pertenece.</p></header><div class="bi-list-controls mb-4"><div class="catalog-global-search"><label class="visually-hidden" for="catalogoBusqueda">Buscar marcas y modelos</label><input class="form-control" type="search" id="catalogoBusqueda" data-global-catalog-search placeholder="Buscar marcas y modelos..."></div></div>
<section class="card shadow-sm border-0 mb-4"><header class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h6 mb-0">Marcas</h2><small class="text-muted">Estado y acciones de cada marca</small></div>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="marca" data-catalog-label="marca" data-bs-toggle="modal" data-bs-target="#marcaModal" aria-label="+ Agregar Marca" title="Agregar Marca">+ Agregar Marca</button>{% endif %}</header><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Marca</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>{% for item in marcas %}<tr data-catalog-row><td class="fw-semibold">{{ item.nombre }}</td><td>{% include 'includes/components/status-badge.twig' with { active: item.activo, active_label: 'Activa', inactive_label: 'Inactiva' } only %}</td><td class="text-end text-nowrap">{% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="marca" data-catalog-label="marca" data-id="{{ item.id_marca }}" data-name="{{ item.nombre }}" data-bs-toggle="modal" data-bs-target="#marcaModal" title="Editar marca"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</button>{% endif %} {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm bi-state-action" href="{{ get_base_url() }}catalogos/cambiar_estado/marca/{{ item.id_marca }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar esta marca?' : '¿Activar esta marca?' }}')"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }} me-1"></i>{{ item.activo ? 'Desactivar' : 'Activar' }}</a>{% endif %}</td></tr>{% else %}<tr data-catalog-no-records><td colspan="3" class="text-center text-muted">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="3" class="text-center text-muted">Sin coincidencias.</td></tr></tbody></table></div></section>
<section class="card shadow-sm border-0"><header class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h6 mb-0">Modelos</h2><small class="text-muted">La marca se indica en cada fila</small></div>{% if can_manage_catalogs|default(false) %}<button type="button" class="btn bi-btn-primary bi-button-label" data-catalog-add="modelo" data-catalog-label="modelo" data-bs-toggle="modal" data-bs-target="#modeloModal" aria-label="+ Agregar Modelo" title="Agregar Modelo">+ Agregar Modelo</button>{% endif %}</header><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Marca</th><th>Modelo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody data-catalog-table>{% for item in modelos %}<tr data-catalog-row><td class="fw-semibold">{{ item.marca_nombre }}</td><td>{{ item.nombre }}</td><td>{% include 'includes/components/status-badge.twig' with { active: item.activo } only %}</td><td class="text-end text-nowrap">{% if can_manage_catalogs|default(false) %}<button type="button" class="btn btn-sm btn-outline-secondary" data-catalog-edit="modelo" data-catalog-label="modelo" data-id="{{ item.id_modelo }}" data-name="{{ item.nombre }}" data-parent="{{ item.id_marca }}" data-bs-toggle="modal" data-bs-target="#modeloModal" title="Editar modelo"><i class="fa-solid fa-pen-to-square me-1"></i>Editar</button>{% endif %} {% if can_inactivate_catalogs|default(false) %}<a class="btn btn-sm bi-state-action" href="{{ get_base_url() }}catalogos/cambiar_estado/modelo/{{ item.id_modelo }}?_t={{ csrf }}" onclick="return confirm('{{ item.activo ? '¿Desactivar este modelo?' : '¿Activar este modelo?' }}')"><i class="fa-solid {{ item.activo ? 'fa-toggle-off' : 'fa-toggle-on' }} me-1"></i>{{ item.activo ? 'Desactivar' : 'Activar' }}</a>{% endif %}</td></tr>{% else %}<tr data-catalog-no-records><td colspan="4" class="text-center text-muted">Sin registros.</td></tr>{% endfor %}<tr class="d-none" data-search-empty><td colspan="4" class="text-center text-muted">Sin coincidencias.</td></tr></tbody></table></div></section>
<div class="modal fade" id="marcaModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/marca" data-catalog-form="marca"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar marca</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Nombre de la marca</label><input class="form-control" name="nombre" required maxlength="100"></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button></div></form></div></div></div>
<div class="modal fade" id="modeloModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" action="{{ get_base_url() }}catalogos/guardar/modelo" data-catalog-form="modelo"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="modal-header"><h2 class="modal-title fs-5" data-catalog-title>Agregar modelo</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><label class="form-label">Marca</label><select class="form-select mb-3" name="id_marca" required><option value="">Seleccionar marca...</option>{% for marca in marcas %}<option value="{{ marca.id_marca }}" data-active="{{ marca.activo }}">{{ marca.nombre }}{% if not marca.activo %} (Inactiva){% endif %}</option>{% endfor %}</select><label class="form-label">Nombre del modelo</label><input class="form-control" name="nombre" required maxlength="100"></div><div class="modal-footer"><button type="submit" class="btn bi-btn-primary bi-modal-save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span data-submit-label>Guardar</span></button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button></div></form></div></div></div>
{% include 'includes/admin/inventory-bottom.twig' %}
