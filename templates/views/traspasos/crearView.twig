{% include 'includes/admin/inventory-top.twig' %}
<div class="transfer-page">
  <header class="transfer-header mb-4"><a class="small text-muted" href="{{ get_base_url() }}traspasos"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver a traspasos</a><h1 class="h3 bi-title mt-2 mb-1">Nuevo traspaso</h1><p class="text-muted mb-0">Define el origen, los bienes y el destino. Revisarás toda la información antes de crear el expediente.</p>{% if preseleccion_mensaje %}<div class="alert alert-info mt-3 mb-0" role="status">{{ preseleccion_mensaje }}</div>{% endif %}</header>
  <form method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/crear" class="card transfer-form-card" data-transfer-create data-goods-url="{{ get_base_url() }}traspasos/bienes-origen/" data-target-keepers-url="{{ get_base_url() }}traspasos/resguardantes-destino/" data-preselected-keeper="{{ resguardante_actual_preseleccionado|default('') }}" data-preselected-goods="{{ bienes_preseleccionados|default([])|join(',') }}" novalidate>
    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="id_unidad_origen" data-origin-unit><input type="hidden" name="id_unidad_destino" data-target-unit><input type="hidden" name="id_resguardante_origen" data-origin-keeper><input type="hidden" name="id_resguardante_destino" data-target-keeper>
    <script type="application/json" data-transfer-units>{{ unidades|json_encode(constant('JSON_HEX_TAG'))|raw }}</script><script type="application/json" data-transfer-keepers>{{ resguardantes|json_encode(constant('JSON_HEX_TAG'))|raw }}</script><template data-location-options>{% for location in ubicaciones %}<option value="{{ location.id_ubicacion }}">{{ location.municipio }} — {{ location.localidad }}</option>{% endfor %}</template>
    <div class="card-body p-3 p-md-4">
      <ol class="transfer-stepper" data-transfer-progress aria-label="Pasos para crear un traspaso"><li class="transfer-step is-current" aria-current="step"><span class="transfer-step__number">1</span><span class="transfer-step__label">Tipo y origen</span></li><li class="transfer-step"><span class="transfer-step__number">2</span><span class="transfer-step__label">Bienes</span></li><li class="transfer-step"><span class="transfer-step__number">3</span><span class="transfer-step__label">Destino y oficio</span></li><li class="transfer-step"><span class="transfer-step__number">4</span><span class="transfer-step__label">Revisión</span></li></ol>
      <div class="alert alert-danger transfer-feedback py-2" data-transfer-feedback role="alert" hidden><span data-transfer-feedback-message></span><button class="transfer-feedback__close" type="button" data-transfer-feedback-close aria-label="Cerrar notificación" title="Cerrar notificación"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>

      <section data-transfer-step="1"><h2 class="h5">Tipo y origen</h2><p class="text-muted">Elige el tipo de cambio y después identifica a quien tiene actualmente los bienes.</p><fieldset><legend class="form-label">¿Qué tipo de traspaso deseas realizar?</legend><div class="row g-3"><div class="col-md-6"><label class="transfer-kind"><input type="radio" name="tipo" value="MISMA_UNIDAD" required><span class="transfer-kind__card"><span class="transfer-kind__icon"><i class="fa-solid fa-people-arrows-left-right" aria-hidden="true"></i></span><strong class="mt-2">Cambio de resguardante</strong><small>Los bienes permanecen en la misma Unidad Administrativa.</small></span></label></div><div class="col-md-6"><label class="transfer-kind"><input type="radio" name="tipo" value="ENTRE_UNIDADES" required><span class="transfer-kind__card"><span class="transfer-kind__icon"><i class="fa-solid fa-building-circle-arrow-right" aria-hidden="true"></i></span><strong class="mt-2">Traspaso entre Unidades Administrativas</strong><small>Adjunta el oficio con autorización externa; TI validará el documento.</small></span></label></div></div></fieldset>
        <div class="row g-3 mt-1"><div class="col-lg-8"><label class="form-label" for="transferSourceKeeperSearch">Resguardante actual</label><div class="transfer-autocomplete" data-autocomplete="origin"><div class="transfer-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="form-control" id="transferSourceKeeperSearch" placeholder="Buscar por nombre o CSP..." autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-describedby="originKeeperHelp"></div><div class="transfer-results" role="listbox" hidden></div></div><div class="form-text" id="originKeeperHelp">Selecciona una persona de la lista para ver sus bienes disponibles.</div><div class="transfer-selection" data-origin-selection hidden><div><strong data-origin-selection-name></strong><small data-origin-selection-meta></small></div><button class="transfer-clear" type="button" data-clear-origin aria-label="Cambiar resguardante actual"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div></div></div>
        <div class="d-flex justify-content-end mt-4"><button class="btn bi-btn-primary bi-button-label" type="button" data-next-step><span>Continuar</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div>
      </section>

      <section data-transfer-step="2" hidden><h2 class="h5">Bienes a traspasar</h2><p class="text-muted">Solo se muestran bienes activos que siguen bajo resguardo de la persona seleccionada.</p><div class="transfer-search-card mb-3"><label class="form-label" for="goodsSearch">Buscar bienes disponibles</label><div class="transfer-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="form-control" id="goodsSearch" type="search" placeholder="Buscar por clave interna, inventario, descripción o serie..." autocomplete="off"></div></div><div class="d-flex flex-wrap align-items-center gap-3 mb-3"><label class="form-check mb-0"><input class="form-check-input" type="checkbox" data-select-all-current><span class="ms-2">Seleccionar todos los resultados actuales</span></label><span class="transfer-status transfer-status--neutral" data-transfer-selected-count>0 bienes seleccionados</span></div><div class="table-responsive border rounded"><table class="table table-sm table-hover align-middle mb-0 transfer-goods-table"><thead><tr><th scope="col">Seleccionar</th><th scope="col">Bien</th><th scope="col">Marca / modelo</th><th scope="col">Ubicación destino</th></tr></thead><tbody data-goods-list><tr><td colspan="4" class="text-center py-4 text-muted">Selecciona un resguardante para cargar sus bienes.</td></tr></tbody></table></div><div class="d-flex flex-wrap justify-content-between gap-2 mt-4"><button class="btn btn-outline-secondary bi-button-label" type="button" data-prev-step><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Regresar</span></button><button class="btn bi-btn-primary bi-button-label" type="button" data-next-step><span>Continuar</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div></section>

      <section data-transfer-step="3" hidden>
        <h2 class="h5">Destino y oficio</h2><p class="text-muted">Selecciona dónde quedarán los bienes y quién recibirá su resguardo.</p>
        <div class="row g-3">
          <div class="col-lg-6" data-unit-destination-wrap><label class="form-label" for="targetUnitSearch">Unidad Administrativa destino</label><div class="transfer-autocomplete" data-autocomplete="target-unit"><div class="transfer-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="form-control" id="targetUnitSearch" placeholder="Buscar por nombre o código de UA..." autocomplete="off" aria-autocomplete="list" aria-expanded="false"></div><div class="transfer-results" role="listbox" hidden></div></div><div class="form-text">Puedes reemplazar la unidad elegida en cualquier momento.</div><div class="transfer-selection" data-target-unit-selection hidden><div><strong data-target-unit-name></strong><small data-target-unit-meta></small></div><button class="transfer-clear" type="button" data-clear-target-unit aria-label="Cambiar unidad administrativa destino"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div></div>
          <div class="col-lg-6"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><label class="form-label mb-0" for="transferNewKeeperSearch">Resguardante destino</label><button class="btn btn-sm btn-outline-primary" type="button" data-add-target-keeper data-bs-toggle="modal" data-bs-target="#resguardanteModal" disabled>+ Agregar Resguardante</button></div><div class="transfer-autocomplete mt-2" data-autocomplete="target-keeper"><div class="transfer-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="form-control" id="transferNewKeeperSearch" placeholder="Selecciona una UA y busca por nombre, apellidos o CSP..." autocomplete="off" aria-autocomplete="list" aria-expanded="false" disabled></div><div class="transfer-results" role="listbox" hidden></div></div><div class="form-text">La búsqueda muestra únicamente resguardantes activos de la UA destino.</div><div class="transfer-selection" data-target-keeper-selection hidden><div><strong data-target-keeper-name></strong><small data-target-keeper-meta></small></div><button class="transfer-clear" type="button" data-clear-target-keeper aria-label="Cambiar resguardante destino"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div></div>
          <div class="col-12" data-office-section hidden><div class="border rounded p-3 bg-light"><h3 class="h6">Oficio / autorización externa</h3><p class="small text-muted">Carga el oficio o documento mediante el cual la instancia correspondiente autorizó el traspaso. Este documento es la evidencia de la autorización externa. Solo PDF, máximo 15 MB.</p><div class="row g-3"><div class="col-md-5"><label class="form-label" for="transferOfficeNumber">Número de oficio</label><input class="form-control" id="transferOfficeNumber" name="numero_oficio" maxlength="100"></div><div class="col-md-3"><label class="form-label" for="transferOfficeDate">Fecha del oficio</label><input class="form-control" type="date" id="transferOfficeDate" name="fecha_oficio"></div><div class="col-md-4"><label class="form-label" for="transferOffice">Archivo PDF del oficio</label><input class="form-control" type="file" id="transferOffice" name="oficio" accept=".pdf,application/pdf"><div class="invalid-feedback" data-office-error></div></div></div><div class="transfer-file-preview" data-office-preview hidden><div data-office-media></div><div class="transfer-file-preview__meta"><strong data-office-name></strong><small data-office-details></small><button class="btn btn-sm btn-outline-secondary mt-2" type="button" data-remove-office><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Quitar archivo</button></div></div></div></div>
          <div class="col-md-6"><label class="form-label" for="transferReason">Motivo</label><input class="form-control" id="transferReason" name="motivo" maxlength="250" placeholder="Motivo del traspaso (opcional)"></div><div class="col-md-6"><label class="form-label" for="transferNotes">Observaciones</label><textarea class="form-control" id="transferNotes" name="observaciones" rows="2" maxlength="1000" placeholder="Observaciones adicionales (opcional)"></textarea></div>
        </div><div class="d-flex flex-wrap justify-content-between gap-2 mt-4"><button class="btn btn-outline-secondary bi-button-label" type="button" data-prev-step><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Regresar</span></button><button class="btn bi-btn-primary bi-button-label" type="button" data-next-step><span>Revisar traspaso</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div>
      </section>

      <section data-transfer-step="4" hidden><h2 class="h5">Revisión del traspaso</h2><p class="text-muted">Confirma que origen, bienes, destino y oficio sean correctos antes de crear el expediente.</p><div class="row g-3 mb-3"><div class="col-md-6"><div class="transfer-review-card"><small>Tipo</small><strong data-review-type>—</strong></div></div><div class="col-md-6"><div class="transfer-review-card"><small>Origen</small><strong data-review-source>—</strong><span class="small text-muted" data-review-origin-unit>—</span></div></div><div class="col-md-6"><div class="transfer-review-card"><small>Destino</small><strong data-review-keeper>—</strong><span class="small text-muted" data-review-target-unit>—</span></div></div><div class="col-md-6" data-review-office-wrap hidden><div class="transfer-review-card"><small>Oficio</small><strong data-review-office>—</strong><a class="small" data-review-office-link target="_blank" rel="noopener" hidden>Ver vista previa</a></div></div></div><div class="transfer-review-card mb-3"><small>Bienes seleccionados</small><strong data-review-goods-count>0 bienes</strong><ul class="list-group list-group-flush mt-2" data-review-goods></ul></div><div class="d-flex flex-wrap justify-content-between gap-2 mt-4"><button class="btn btn-outline-secondary bi-button-label" type="button" data-prev-step><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Corregir información</span></button><button class="btn bi-btn-primary bi-button-label" type="submit" data-create-transfer disabled><i class="fa-solid fa-folder-plus" aria-hidden="true"></i><span>Crear traspaso</span></button></div></section>
    </div>
  </form>
</div>
{% include 'views/catalogos/_resguardante-form.twig' with {resguardante_ajax: true, unidades_resguardante: unidades} %}
<script src="{{ get_base_url() }}assets/js/traspasos.js?v={{ get_asset_version() }}"></script>
{% include 'includes/admin/inventory-bottom.twig' %}
