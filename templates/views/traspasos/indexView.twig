{% include 'includes/admin/inventory-top.twig' %}
{% set state_labels = {'PENDIENTE_VALIDACION':'Pendiente de validación','VALIDADO':'Validado','COMPLETADO':'Completado'} %}
{% set state_classes = {'PENDIENTE_VALIDACION':'pending','VALIDADO':'process','COMPLETADO':'done'} %}
<div class="transfer-page" data-transfer-list>
  <header class="transfer-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h3 bi-title mb-1">Traspasos</h1><p class="text-muted mb-0">Gestiona los cambios de resguardante y unidad administrativa de los bienes.</p></div>{% if can_create_transfer %}<a class="btn bi-btn-primary bi-button-label" href="{{ get_base_url() }}traspasos/crear"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>Nuevo traspaso</span></a>{% endif %}</header>

  <form class="card transfer-filter-card mb-4" method="get" action="{{ get_base_url() }}traspasos" data-transfer-filter-form><div class="card-header py-3"><h2 class="h6 mb-1">Buscar y filtrar expedientes</h2><p class="small text-muted mb-0">Escribe o selecciona los criterios y aplica los filtros cuando termines.</p></div><div class="card-body"><div class="row g-3">
    <div class="col-lg-5"><label class="form-label" for="transferSearch">Buscar traspaso</label><div class="transfer-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="form-control" id="transferSearch" type="search" name="q" value="{{ filtros.q }}" placeholder="Folio, resguardante o CSP..." autocomplete="off"></div></div>
    <div class="col-sm-6 col-lg-3"><label class="form-label" for="transferType">Tipo</label><select class="form-select" id="transferType" name="tipo"><option value="">Todos los tipos</option><option value="ENTRE_UNIDADES" {{ filtros.tipo == 'ENTRE_UNIDADES' ? 'selected' : '' }}>Entre unidades</option><option value="MISMA_UNIDAD" {{ filtros.tipo == 'MISMA_UNIDAD' ? 'selected' : '' }}>Cambio dentro de la misma UA</option></select></div>
    <div class="col-sm-6 col-lg-4"><label class="form-label" for="transferState">Estado</label><select class="form-select" id="transferState" name="estado"><option value="">Todos los estados</option>{% for state, label in state_labels %}<option value="{{ state }}" {{ filtros.estado == state ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
    <div class="col-md-6"><label class="form-label" for="transferOrigin">Unidad de origen</label><div class="transfer-autocomplete" data-filter-unit="unidad_origen"><input class="form-control" id="transferOrigin" name="unidad_origen" value="{{ filtros.unidad_origen }}" placeholder="Buscar por nombre o código de UA..." autocomplete="off" aria-autocomplete="list" aria-expanded="false"><div class="transfer-results" role="listbox" hidden></div></div></div>
    <div class="col-md-6"><label class="form-label" for="transferDestination">Unidad de destino</label><div class="transfer-autocomplete" data-filter-unit="unidad_destino"><input class="form-control" id="transferDestination" name="unidad_destino" value="{{ filtros.unidad_destino }}" placeholder="Buscar por nombre o código de UA..." autocomplete="off" aria-autocomplete="list" aria-expanded="false"><div class="transfer-results" role="listbox" hidden></div></div></div>
    <div class="col-md-4"><label class="form-label" for="transferReceiver">Resguardante destino</label><input class="form-control" id="transferReceiver" name="resguardante_destino" value="{{ filtros.resguardante_destino }}" placeholder="Buscar por nombre o CSP..." autocomplete="off"></div><div class="col-md-4"><label class="form-label" for="transferSince">Desde</label><input class="form-control" type="date" id="transferSince" name="desde" value="{{ filtros.desde }}"></div><div class="col-md-4"><label class="form-label" for="transferUntil">Hasta</label><input class="form-control" type="date" id="transferUntil" name="hasta" value="{{ filtros.hasta }}"></div>
    <div class="col-12"><div class="transfer-filter-actions"><a class="btn btn-outline-secondary bi-button-label" href="{{ get_base_url() }}traspasos"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>Limpiar filtros</span></a><button class="btn bi-btn-primary bi-button-label" type="submit"><i class="fa-solid fa-filter" aria-hidden="true"></i><span>Aplicar filtros</span></button></div></div>
  </div></div></form>
  <script type="application/json" data-transfer-units>{{ unidades|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>

  <section class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Folio</th><th>Tipo</th><th>Origen</th><th>Destino</th><th>Bienes</th><th>Estado</th><th>Fecha</th><th class="text-end">Acciones</th></tr></thead><tbody>
  {% for item in traspasos %}<tr><td class="fw-semibold">{{ item.folio }}</td><td>{{ item.tipo == 'ENTRE_UNIDADES' ? 'Entre unidades' : 'Misma unidad' }}</td><td>{{ item.resguardante_origen_nombre|default('Resguardante histórico') }}<small class="d-block text-muted">{{ item.resguardante_origen_csp|default('Sin CSP') }} · {{ item.unidad_origen_nombre }}</small></td><td>{{ item.resguardante_destino_nombre }}<small class="d-block text-muted">{{ item.resguardante_destino_csp }} · {{ item.unidad_destino_nombre }}</small></td><td>{{ item.total_bienes }}</td><td><span class="transfer-status transfer-status--{{ state_classes[item.estado]|default('neutral') }}">{{ state_labels[item.estado]|default(item.estado|replace({'_':' '})|title) }}</span></td><td>{{ item.fecha_creacion|date('d/m/Y H:i') }}</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="{{ get_base_url() }}traspasos/detalle/{{ item.id_traspaso }}"><i class="fa-solid fa-eye" aria-hidden="true"></i><span class="visually-hidden">Ver expediente {{ item.folio }}</span></a></td></tr>{% else %}<tr><td colspan="8" class="text-center text-muted py-4">No hay expedientes que coincidan con los filtros.</td></tr>{% endfor %}
  </tbody></table></div></section>
</div>
<script src="{{ get_base_url() }}assets/js/traspasos-list.js?v={{ get_asset_version() }}"></script>
{% include 'includes/admin/inventory-bottom.twig' %}
