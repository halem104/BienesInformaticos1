{% include 'includes/admin/inventory-top.twig' %}
<link href="{{ get_base_url() }}assets/css/traspasos-detalle.css?v={{ get_asset_version() }}" rel="stylesheet">
<div class="transfer-page transfer-detail">
  <nav class="bi-breadcrumbs" aria-label="Ruta de navegación"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ get_base_url() }}admin">Inicio</a></li><li class="breadcrumb-item">Documentos y movimientos</li><li class="breadcrumb-item"><a href="{{ get_base_url() }}traspasos">Traspasos</a></li><li class="breadcrumb-item active" aria-current="page">Detalle del resguardo</li></ol></nav>
  <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
      <h1 class="h3 bi-title mb-1">{{ traspaso.entre_unidades ? 'Traspaso entre área' : 'Traspaso en la misma área' }}</h1>
      <p class="text-muted mb-0">Número del traspaso: <strong>{{ traspaso.folio }}</strong> <span class="transfer-status transfer-status--compact ms-2" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ traspaso.estado_tooltip }}" aria-label="{{ traspaso.estado_tooltip }}">{% if traspaso.estado == 'VALIDADO' %}✓ {% endif %}{{ traspaso.estado_etiqueta }}</span></p>
    </div>
    <a class="btn btn-sm btn-outline-dark" href="{{ get_base_url() }}traspasos"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver a Traspasos</a>
  </header>

  <div class="row g-4">
    <div class="col-12">
      <section class="card border-0 shadow-sm mb-4" aria-labelledby="transferInfoTitle">
        <div class="card-header bg-white"><h2 id="transferInfoTitle" class="h5 mb-0">1. Información del traspaso</h2></div>
        <div class="card-body">
          <div class="row g-2 transfer-info-grid">
            <div class="col-lg-4 col-md-6"><strong class="d-block">Origen</strong>{{ traspaso.unidad_origen_nombre }}<small class="d-block text-muted">{{ traspaso.unidad_origen_codigo|default('Código UA no registrado') }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Destino</strong>{{ traspaso.unidad_destino_nombre }}<small class="d-block text-muted">{{ traspaso.unidad_destino_codigo|default('Código UA no registrado') }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Resguardante origen</strong>{{ traspaso.bienes|length ? traspaso.bienes[0].resguardante_origen_nombre|default('No aplica') : 'No aplica' }}<small class="d-block text-muted">CSP: {{ traspaso.bienes|length ? traspaso.bienes[0].resguardante_origen_csp|default('No registrado') : 'No aplica' }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Resguardante destino</strong>{{ traspaso.resguardante_destino_nombre }}<small class="d-block text-muted">CSP: {{ traspaso.resguardante_destino_csp|default('No registrado') }}</small></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Motivo origen</strong><span class="transfer-readonly-value">{{ traspaso.motivo|default('No aplica') }}</span></div>
            <div class="col-lg-4 col-md-6"><strong class="d-block">Observaciones</strong><span class="transfer-readonly-value">{{ traspaso.observaciones|default('No aplica') }}</span></div>
          </div>
        </div>
      </section>

      <section class="card border-0 shadow-sm mb-4" aria-labelledby="transferGoodsTitle">
        <div class="card-header bg-white d-flex justify-content-between align-items-center"><h2 id="transferGoodsTitle" class="h5 mb-0">Bienes incluidos</h2><span class="badge text-bg-light">{{ traspaso.bienes|length }}</span></div>
        <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>CI / Inventario</th><th>Bien</th><th>Resguardante anterior</th><th>Ubicación destino</th></tr></thead><tbody>
          {% for item in traspaso.bienes %}<tr><td>{{ item.clave_interna }}<small class="d-block text-muted">{{ item.numero_inventario|default('') }}</small></td><td>{{ item.nombre_bien }}<small class="d-block text-muted">{{ item.numero_serie|default('') }}</small></td><td>{{ item.resguardante_origen_nombre|default('Sin resguardante') }}<small class="d-block text-muted">{{ item.resguardante_origen_csp|default('') }}</small></td><td>{% if item.ubicacion_sin_cambio %}{{ item.municipio_actual|default('') }}{% if item.localidad_actual %} — {{ item.localidad_actual }}{% endif %}{% else %}{{ item.municipio_destino|default('') }}{% if item.localidad_destino %} — {{ item.localidad_destino }}{% endif %}{% endif %}</td></tr>{% endfor %}
        </tbody></table></div>
      </section>

      {% if traspaso.entre_unidades %}
        <section class="card border-0 shadow-sm mb-4" id="autorizacion-externa" aria-labelledby="transferOfficeTitle">
          <div class="card-header bg-white"><h2 id="transferOfficeTitle" class="h5 mb-0">2. Autorización externa</h2></div>
          <div class="card-body">
            <p class="small text-muted">La autorización la emite la instancia externa correspondiente. El sistema solamente valida documentalmente que el oficio cargado corresponda al traspaso.</p>
            <div class="row g-3"><div class="col-lg-8">
            {% if traspaso.estado in ['PENDIENTE_VALIDACION','VALIDADO'] and transfer_permissions.subir_documento %}
              <form method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/subir-documento/{{ traspaso.id_traspaso }}" class="row g-3 align-items-end mb-3"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="autorizacion-externa">
                <div class="col-md-4"><label class="form-label" for="transferOfficeNumber">Número de oficio</label><input class="form-control" id="transferOfficeNumber" name="numero_oficio" maxlength="100" required></div>
                <div class="col-md-3"><label class="form-label" for="transferOfficeDate">Fecha del oficio</label><input class="form-control" type="date" id="transferOfficeDate" name="fecha_oficio" required></div>
                <div class="col-md-5"><label class="form-label" for="transferOffice">Cargar o reemplazar oficio (PDF, máximo 15 MB)</label><input class="form-control" type="file" id="transferOffice" name="oficio" accept=".pdf,application/pdf" required></div>
                <div class="col-12"><button class="btn btn-outline-primary" type="submit">Cargar oficio</button></div>
              </form>
            {% endif %}
            {% if traspaso.oficio_actual %}{% set doc = traspaso.oficio_actual %}
              <article class="transfer-document-card mb-3">
                <div class="transfer-file-heading"><span class="transfer-pdf-icon" aria-hidden="true"><i class="fa-solid fa-file-pdf"></i></span><div><strong>{{ doc.nombre_original }}</strong><small class="d-block text-muted">PDF · {{ doc.tamano_legible }} · Oficio {{ doc.metadata.numero_oficio|default('sin número') }} · {{ doc.metadata.fecha_oficio|default('fecha no capturada') }} · Cargado {{ doc.fecha_carga|date('d/m/Y H:i') }}</small></div></div>
                <div class="transfer-actions mt-2">
                  {% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener"><i class="fa-regular fa-eye me-1" aria-hidden="true"></i>Ver archivo</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener" aria-label="Imprimir oficio" onclick="const pdf=window.open(this.href,'_blank');if(pdf)pdf.addEventListener('load',()=>pdf.print());return false;"><i class="fa-solid fa-print me-1" aria-hidden="true"></i>Imprimir</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}"><i class="fa-solid fa-download me-1" aria-hidden="true"></i>Descargar archivo</a>{% endif %}
                </div>
              </article>
            {% endif %}
            {% if not traspaso.tiene_oficio_externo %}<p class="alert alert-warning mb-3">Aún no hay un oficio de autorización en el expediente.</p>{% endif %}
            </div><div class="col-lg-4"><div class="transfer-validation-status h-100"><strong class="d-block mb-2">Estado de validación</strong>
              {% if traspaso.fecha_autorizacion %}<span class="text-success" data-bs-toggle="tooltip" title="Validado por: {{ traspaso.autorizador_username|default('usuario no disponible') }}&#10;Fecha: {{ traspaso.fecha_autorizacion|date('d/m/Y H:i') }}">✓ Oficio Validado</span><small class="d-block">Validado por {{ traspaso.autorizador_username|default('usuario no disponible') }} · {{ traspaso.fecha_autorizacion|date('d/m/Y H:i') }}</small>
              {% else %}<span class="text-warning-emphasis">Pendiente de validar</span>{% endif %}
              {% if traspaso.estado == 'PENDIENTE_VALIDACION' and traspaso.tiene_oficio_externo and is_transfer_admin and transfer_permissions.autorizar %}<form method="post" action="{{ get_base_url() }}traspasos/autorizar/{{ traspaso.id_traspaso }}" class="mt-3"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="autorizacion-externa"><button class="btn btn-sm" type="submit"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>Validar oficio</button></form>{% endif %}
            </div></div></div>
          </div>
        </section>
      {% endif %}

      <section class="card border-0 shadow-sm mb-4" id="documentos-expediente" aria-labelledby="transferDocumentsTitle">
        <div class="card-header bg-white"><h2 id="transferDocumentsTitle" class="h5 mb-0">{{ traspaso.tipo == 'ENTRE_UNIDADES' ? '3' : '2' }}. Documentos del expediente</h2></div>
        <div class="card-body">
          <p class="small text-muted">Los documentos generados pueden revisarse en vista previa PDF. Imprime para recabar firmas manuscritas y digitaliza los formatos firmados; el sistema no registra firmas digitales.</p>
          <p class="small text-muted">La baja documental de resguardante no da de baja el bien en inventario.</p>

          {% if traspaso.hay_versiones_anteriores %}<details class="mb-3"><summary class="fw-semibold">Versiones anteriores del expediente</summary><div class="pt-2">
            {% for doc in traspaso.documentos %}{% if doc.tipo_documento in ['TARJETA_RESGUARDO','RESGUARDO_EQUIPO'] and not doc.id_bien and not doc.es_evidencia %}<article class="transfer-document-card mb-2"><strong>Documento histórico sin asociación por bien · {{ doc.tipo_documento|replace({'_':' '})|title }}</strong><small class="d-block text-muted">{{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small>{% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm mt-2" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar</a>{% endif %}</article>{% endif %}{% endfor %}
            {% for doc in traspaso.documentos %}{% if doc.obsoleto and doc.id_bien and not doc.es_evidencia %}<article class="transfer-document-card mb-2"><strong>Versión anterior · {{ doc.tipo_documento|replace({'_':' '})|title }}</strong><small class="d-block text-muted">{{ doc.bien_label }} · {{ doc.nombre_original }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small>{% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm mt-2" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar versión anterior</a>{% endif %}</article>{% endif %}{% endfor %}
          </div></details>{% endif %}

          {% if traspaso.documentos_vigentes %}
            {% for doc in traspaso.documentos_vigentes %}
              <article class="transfer-document-card mb-3" id="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}">
                <div class="transfer-document-row"><div class="transfer-file-heading"><span class="transfer-pdf-icon" aria-hidden="true"><i class="fa-solid fa-file-pdf"></i></span><div><strong>{{ doc.tipo_documento == 'TARJETA_RESGUARDO' ? 'Tarjeta de resguardo' : (doc.tipo_documento == 'BAJA_RESGUARDANTE' ? 'Baja de resguardante' : 'Resguardo del equipo') }}</strong> <span class="badge text-bg-light">{{ doc.origen_archivo == 'GENERADO' ? 'Generado' : 'PDF cargado' }}</span><small class="d-block">{{ doc.bien_label }}</small><small class="d-block text-muted">{{ doc.nombre_original }} · PDF · {{ doc.tamano_legible }} · {{ doc.fecha_carga|date('d/m/Y H:i') }}</small></div></div>
                  <div class="transfer-actions">{% if transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener">Ver</a>{% if doc.origen_archivo == 'GENERADO' %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.id_traspaso_documento }}" target="_blank" rel="noopener" aria-label="Imprimir {{ doc.bien_label }}" onclick="const pdf=window.open(this.href,'_blank');if(pdf)pdf.addEventListener('load',()=>pdf.print());return false;">Imprimir</a>{% endif %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.id_traspaso_documento }}">Descargar</a>{% endif %}
                    {% if doc.evidencia_archivo and transfer_permissions['descargar-documentos'] %}<a class="btn btn-sm" href="{{ get_base_url() }}traspasos/ver-documento/{{ doc.evidencia_archivo.id_traspaso_documento }}" target="_blank" rel="noopener">Ver evidencia</a><a class="btn btn-sm" href="{{ get_base_url() }}traspasos/descargar-documento/{{ doc.evidencia_archivo.id_traspaso_documento }}">Descargar evidencia</a>{% endif %}
                    {% if doc.evidencia_archivo and traspaso.estado == 'VALIDADO' and transfer_permissions['subir-documento'] %}<button class="btn btn-sm" type="button" data-evidence-trigger="signedDocument{{ doc.id_traspaso_documento }}">Cambiar evidencia</button>{% endif %}</div>
                </div>
                {% if doc.tipo_documento == 'TARJETA_RESGUARDO' and doc.puede_editar_tarjeta %}{% set tarjetaFields = [
                  ['secretaria','1) SECRETARÍA'],['subsecretaria','2) SUBSECRETARÍA'],['direccion','3) DIRECCIÓN'],['direccion_area','4) DIRECCIÓN DE ÁREA'],['subdireccion','5) SUBDIRECCIÓN'],['departamento','6) DEPARTAMENTO'],['oficina','7) OFICINA'],['codigo_ua','8) CÓDIGO DE UNIDAD ADMINISTRATIVA'],['activo_generico','9) ACTIVO GENÉRICO'],['grupo_activo','10) GRUPO DEL ACTIVO'],['activo_especifico','11) ACTIVO ESPECÍFICO'],['nombre_bien','12) NOMBRE DEL BIEN'],['material','13) MATERIAL'],['marca','14) MARCA'],['modelo','15) MODELO'],['color','16) COLOR'],['estado_uso','17) ESTADO DE USO'],['serie','18) SERIE'],['caracteristicas','19) CARACTERÍSTICAS (MATRÍCULA O REGISTRO)'],['observaciones','20) OBSERVACIONES'],['fecha_alta','21) FECHA DE ALTA'],['fecha_adquisicion','22) FECHA DE ADQUISICIÓN'],['fecha_elaboracion','23) FECHA DE ELABORACIÓN'],['fecha_asignacion','24) FECHA DE ASIGNACIÓN'],['valor','25) VALOR'],['ubicacion_fisica','26) UBICACIÓN FÍSICA DEL BIEN'],['municipio','27) MUNICIPIO'],['localidad','28) LOCALIDAD'] ] %}
                  <details class="transfer-card-editor mt-2"><summary class="btn btn-sm">Editar datos de la tarjeta</summary><form method="post" action="{{ get_base_url() }}traspasos/editar-datos-documentos/{{ traspaso.id_traspaso }}" class="row g-2 mt-2" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_tarjeta" value="{{ doc.id_traspaso_documento }}"><p class="small text-muted mb-1">Los valores iniciales provienen del inventario, la unidad destino y el expediente. Los ajustes se guardan en esta tarjeta y no modifican los registros fuente.</p>
                    <div class="col-md-6"><label class="form-label small" for="tarjetaInventario{{ doc.id_bien }}">Inventario</label><input class="form-control form-control-sm" id="tarjetaInventario{{ doc.id_bien }}" name="campos_tarjeta[inventario]" maxlength="100" value="{{ doc.tarjeta_campos.inventario|default('') }}"></div><div class="col-md-6"><label class="form-label small" for="tarjetaNic{{ doc.id_bien }}">NIC / CEA</label><input class="form-control form-control-sm" id="tarjetaNic{{ doc.id_bien }}" name="campos_tarjeta[nic_cea]" maxlength="100" value="{{ doc.tarjeta_campos.nic_cea|default('') }}"></div>
                    {% for field in tarjetaFields %}<div class="col-md-6"><label class="form-label small" for="tarjeta{{ field[0] }}{{ doc.id_bien }}">{{ field[1] }}</label>{% if field[0] in ['observaciones','caracteristicas','ubicacion_fisica'] %}<textarea class="form-control form-control-sm" id="tarjeta{{ field[0] }}{{ doc.id_bien }}" name="campos_tarjeta[{{ field[0] }}]" rows="2" maxlength="{{ field[0] == 'observaciones' ? 1000 : 500 }}">{{ doc.tarjeta_campos[field[0]]|default('') }}</textarea>{% else %}<input class="form-control form-control-sm" id="tarjeta{{ field[0] }}{{ doc.id_bien }}" name="campos_tarjeta[{{ field[0] }}]" maxlength="500" value="{{ doc.tarjeta_campos[field[0]]|default('') }}">{% endif %}</div>{% endfor %}
                    <div class="col-12"><button class="btn btn-sm" type="submit">Guardar cambios y actualizar PDF</button></div></form></details>
                {% endif %}
                {% if doc.tipo_documento == 'BAJA_RESGUARDANTE' %}<div class="transfer-ccp-editor mt-2">
                  {% if traspaso.puede_editar_ccp_baja %}<form method="post" action="{{ get_base_url() }}traspasos/editar-datos-documentos/{{ traspaso.id_traspaso }}" class="d-flex flex-wrap align-items-end gap-2" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_baja" value="{{ doc.id_traspaso_documento }}"><div class="flex-grow-1"><label class="small fw-semibold" for="ccpBaja{{ doc.id_bien }}">C. c. p.</label><textarea class="form-control form-control-sm" id="ccpBaja{{ doc.id_bien }}" name="ccp" rows="2" maxlength="500">{{ doc.ccp_baja|default('') }}</textarea></div><button class="btn btn-sm" type="submit">Guardar C. c. p.</button><small class="text-muted w-100">Campo opcional; regenera la baja para reflejar el cambio en el PDF.</small></form>
                  {% elseif doc.ccp_baja %}<p class="small mb-0"><strong>C. c. p.</strong> {{ doc.ccp_baja }}</p>{% endif %}
                </div>{% endif %}
                <div class="transfer-evidence"><strong class="small d-block mb-2">Evidencia firmada y digitalizada</strong>
                  {% if doc.evidencia_archivo %}<div class="transfer-evidence-status"><span class="badge {{ doc.evidencia_validada ? 'text-bg-success' : 'text-bg-warning' }}">{{ doc.evidencia_validada ? '✓ Validado' : 'Pendiente de validación' }}</span> · {{ doc.evidencia_archivo.nombre_original }} · {{ doc.evidencia_archivo.tipo_archivo }} · {{ doc.evidencia_archivo.tamano_legible }} · {{ doc.evidencia_archivo.fecha_carga|date('d/m/Y H:i') }}{% if doc.evidencia_archivo.usuario_carga %} · {{ doc.evidencia_archivo.usuario_carga }}{% endif %}</div>
                    {% if doc.evidencia_validada and doc.validacion_evidencia %}<small class="d-block text-success mt-1">Validado por {{ doc.validacion_evidencia.username|default('administrador') }} · {{ doc.validacion_evidencia.fecha_evento|date('d/m/Y H:i') }}</small>{% elseif is_transfer_admin and transfer_permissions.autorizar %}<form method="post" action="{{ get_base_url() }}traspasos/validar-evidencia/{{ traspaso.id_traspaso }}" class="d-inline-block mt-2"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="documento_origen" value="{{ doc.id_traspaso_documento }}"><input type="hidden" name="documento_evidencia" value="{{ doc.evidencia_archivo.id_traspaso_documento }}"><button class="btn btn-sm" type="submit">Validar evidencia</button></form>{% endif %}
                  {% else %}<span class="badge text-bg-light">Pendiente de evidencia</span><span class="text-muted small">Imprime el PDF, recaba firmas manuscritas y digitalízalo.</span>{% endif %}
                  {% if traspaso.estado == 'VALIDADO' and transfer_permissions['subir-documento'] %}<form id="evidenceForm{{ doc.id_traspaso_documento }}" method="post" enctype="multipart/form-data" action="{{ get_base_url() }}traspasos/subir-documento-firmado/{{ traspaso.id_traspaso }}" class="transfer-evidence-upload" data-preserve-anchor="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="documento_origen" value="{{ doc.id_traspaso_documento }}"><input type="hidden" name="return_anchor" value="documento-{{ doc.id_bien }}-{{ doc.tipo_documento }}"><label class="small" for="signedDocument{{ doc.id_traspaso_documento }}">{% if doc.evidencia_archivo %}Seleccionar nueva versión de evidencia{% else %}Elegir archivo firmado y digitalizado{% endif %}</label><input class="form-control form-control-sm" id="signedDocument{{ doc.id_traspaso_documento }}" type="file" name="documento_firmado" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required {% if doc.evidencia_archivo %}hidden{% endif %}>{% if not doc.evidencia_archivo %}<button class="btn btn-sm" type="submit">Agregar evidencia</button>{% endif %}</form>{% endif %}
                  {% if doc.evidencias_anteriores %}<details class="mt-2"><summary>Versiones anteriores ({{ doc.evidencias_anteriores|length }})</summary>{% for oldEvidence in doc.evidencias_anteriores %}<div class="small mt-2">{{ oldEvidence.nombre_original }} · {{ oldEvidence.fecha_carga|date('d/m/Y H:i') }}{% if transfer_permissions['descargar-documentos'] %} · <a href="{{ get_base_url() }}traspasos/ver-documento/{{ oldEvidence.id_traspaso_documento }}" target="_blank" rel="noopener">Ver</a> · <a href="{{ get_base_url() }}traspasos/descargar-documento/{{ oldEvidence.id_traspaso_documento }}">Descargar</a>{% endif %}</div>{% endfor %}</details>{% endif %}
                </div>
              </article>
            {% endfor %}
          {% else %}<p class="text-muted">Aún no se han generado los documentos obligatorios.</p>{% endif %}

          {% if traspaso.evidencias_historicas %}<details class="mt-3"><summary class="fw-semibold">Evidencias de versiones anteriores</summary>{% for oldEvidence in traspaso.evidencias_historicas %}<div class="small mt-2">{{ oldEvidence.nombre_original }} · {{ oldEvidence.tamano_legible }} · {{ oldEvidence.fecha_carga|date('d/m/Y H:i') }}{% if transfer_permissions['descargar-documentos'] %} · <a href="{{ get_base_url() }}traspasos/ver-documento/{{ oldEvidence.id_traspaso_documento }}" target="_blank" rel="noopener">Ver</a> · <a href="{{ get_base_url() }}traspasos/descargar-documento/{{ oldEvidence.id_traspaso_documento }}">Descargar</a>{% endif %}</div>{% endfor %}</details>{% endif %}

          {% if traspaso.estado == 'VALIDADO' and transfer_permissions['generar-tarjeta'] and transfer_permissions['generar-resguardo'] %}
            <form method="post" action="{{ get_base_url() }}traspasos/generar-documentos/{{ traspaso.id_traspaso }}" class="transfer-generate-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documentos-expediente"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h3 class="h6 mb-1">Documentos del expediente</h3><p class="small text-muted mb-0">La baja documental se genera únicamente cuando existe un resguardante anterior. La baja no modifica el estado de los bienes.</p></div><button class="btn btn-sm" type="submit" title="Actualiza los documentos del expediente con las fechas y datos actuales. No modifica el estado de los bienes." aria-label="Actualizar documentos"><i class="fa-solid fa-arrows-rotate me-1" aria-hidden="true"></i>Actualizar documentos</button></div>
            </form>
          {% endif %}

          {% if traspaso.estado == 'VALIDADO' and transfer_permissions.ejecutar and traspaso.listo_para_completar %}<form method="post" action="{{ get_base_url() }}traspasos/completar/{{ traspaso.id_traspaso }}" class="mt-3" onsubmit="return confirm('¿Confirmas completar el traspaso? Se actualizarán la unidad, ubicación y resguardo de todos los bienes y se registrarán sus movimientos.');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="return_anchor" value="documentos-expediente"><button class="btn" type="submit"><i class="fa-solid fa-check-double me-1" aria-hidden="true"></i>Completar traspaso</button></form>{% elseif traspaso.estado == 'VALIDADO' and transfer_permissions.ejecutar %}<p class="small text-muted mt-3 mb-0">Para completar, cada documento requerido debe tener evidencia vigente validada por un administrador.</p>{% endif %}

        </div>
      </section>

    </div>

    <div class="col-12">
      {% if traspaso.estado == 'COMPLETADO' and is_transfer_admin and transfer_permissions['crear'] %}<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Reversión</h2></div><div class="card-body"><form method="post" action="{{ get_base_url() }}traspasos/revertir/{{ traspaso.id_traspaso }}" class="vstack gap-2"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label" for="reverseReason">Motivo de reversión</label><textarea class="form-control" id="reverseReason" name="motivo" required maxlength="500"></textarea><button class="btn" type="submit">Crear expediente compensatorio</button></form></div></section>{% endif %}

      <section class="card border-0 shadow-sm mb-4" aria-labelledby="transferHistoryTitle">
        <div class="card-header bg-white"><h2 id="transferHistoryTitle" class="h5 mb-0">{{ traspaso.tipo == 'ENTRE_UNIDADES' ? '4' : '3' }}. Historial del expediente</h2></div>
        <div class="transfer-timeline" data-transfer-timeline>{% for event in traspaso.eventos %}<article class="transfer-timeline__event" {% if traspaso.eventos|length > 2 and loop.index <= traspaso.eventos|length - 2 %}hidden data-history-extra{% endif %}><span class="transfer-timeline__marker" aria-hidden="true"></span><div><div class="d-flex justify-content-between flex-wrap gap-2"><strong>{{ event.tipo_evento|replace({'_':' '})|title }}</strong><time class="text-muted" datetime="{{ event.fecha_evento|date('c') }}">{{ event.fecha_evento|date('d/m/Y H:i') }}</time></div><div>Usuario: {{ event.username|default('Usuario no disponible') }}{% if event.estado_anterior or event.estado_nuevo %} · {{ event.estado_anterior|default('—') }} → {{ event.estado_nuevo|default('—') }}{% endif %}</div>{% if event.motivo %}<small class="text-muted">{{ event.motivo }}</small>{% endif %}{% if event.metadatos.tipo|default(null) %}<small class="d-block text-muted">Documento: {{ event.metadatos.tipo|replace({'_':' '})|title }}{% if event.metadatos.version|default(null) %} · versión {{ event.metadatos.version }}{% endif %}</small>{% endif %}</div></article>{% else %}<p class="text-muted">Sin eventos.</p>{% endfor %}</div>{% if traspaso.eventos|length > 2 %}<button class="btn btn-sm mt-3" type="button" data-history-toggle aria-expanded="false">Mostrar historial completo</button>{% endif %}
      </section>

    </div>
  </div>
</div>
<script src="{{ get_base_url() }}assets/js/traspasos-detalle.js?v={{ get_asset_version() }}"></script>
{% include 'includes/admin/inventory-bottom.twig' %}
